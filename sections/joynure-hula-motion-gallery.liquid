{%- capture enabled_flag -%}
  {%- render 'joynure-hula-landing-enabled', product: product -%}
{%- endcapture -%}
{%- if enabled_flag == 'true' and section.settings.enabled -%}
  {{ 'joynure-hula-landing.css' | asset_url | stylesheet_tag }}
  <section class="joynure-hula-landing joynure-hula-landing__section" {{ section.shopify_attributes }}>
    <div class="joynure-hula-landing__inner">
      <h2 class="joynure-hula-landing__title joynure-hula-landing__title--center">{{ section.settings.heading | escape }}</h2>
      <p class="joynure-hula-landing__lede joynure-hula-landing__lede--center">{{ section.settings.lede | escape }}</p>
      <p class="joynure-hula-demo-note" style="text-align:center;margin-bottom:1rem;">
        {{ section.settings.demo_note | escape }}
      </p>
      <div class="joynure-hula-strip__track">
        {% for i in (1..5) %}
          {% liquid
            assign ik = 'image_' | append: i
            assign mk = 'media_id_' | append: i
            assign ck = 'caption_' | append: i
          %}
          <figure class="joynure-hula-strip__card">
            {% render 'joynure-hula-media',
              product: product,
              setting_image: section.settings[ik],
              media_id: section.settings[mk],
              alt: section.settings[ck],
              class: 'joynure-hula-landing__media',
              loading: 'lazy',
              sizes: '(min-width: 750px) 20vw, 70vw'
            %}
            {% if section.settings[ck] != blank %}
              <figcaption class="joynure-hula-strip__caption">{{ section.settings[ck] | escape }}</figcaption>
            {% endif %}
          </figure>
        {% endfor %}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "JOYNURE Hula motion gallery",
  "tag": "section",
  "class": "joynure-hula-landing-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Enable section", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "See JOYNURE in Motion" },
    { "type": "textarea", "id": "lede", "label": "Supporting copy", "default": "Product demonstration scenes for Pink, Purple, and Blue." },
    { "type": "text", "id": "demo_note", "label": "Disclaimer", "default": "Product demonstrations — not customer reviews or testimonials." },
    { "type": "image_picker", "id": "image_1", "label": "Image 1" },
    { "type": "text", "id": "media_id_1", "label": "Media ID 1", "default": "45010744803601" },
    { "type": "text", "id": "caption_1", "label": "Caption 1", "default": "Pink in motion" },
    { "type": "image_picker", "id": "image_2", "label": "Image 2" },
    { "type": "text", "id": "media_id_2", "label": "Media ID 2", "default": "45011048595729" },
    { "type": "text", "id": "caption_2", "label": "Caption 2", "default": "Purple at home" },
    { "type": "image_picker", "id": "image_3", "label": "Image 3" },
    { "type": "text", "id": "media_id_3", "label": "Media ID 3", "default": "45011048661265" },
    { "type": "text", "id": "caption_3", "label": "Caption 3", "default": "Blue setup" },
    { "type": "image_picker", "id": "image_4", "label": "Image 4" },
    { "type": "text", "id": "media_id_4", "label": "Media ID 4", "default": "45010788942097" },
    { "type": "text", "id": "caption_4", "label": "Caption 4", "default": "Close-up track" },
    { "type": "image_picker", "id": "image_5", "label": "Image 5" },
    { "type": "text", "id": "media_id_5", "label": "Media ID 5", "default": "45011023069457" },
    { "type": "text", "id": "caption_5", "label": "Caption 5", "default": "All three colors" }
  ],
  "presets": [{ "name": "JOYNURE Hula motion gallery" }]
}
{% endschema %}
