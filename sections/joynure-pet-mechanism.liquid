{%- capture enabled_flag -%}
  {%- render 'joynure-pet-landing-enabled', product: product -%}
{%- endcapture -%}
{%- if enabled_flag == 'true' -%}
  {{ 'joynure-hula-landing.css' | asset_url | stylesheet_tag }}
  <section class="joynure-hula-landing joynure-hula-landing__section" {{ section.shopify_attributes }}>
    <div class="joynure-hula-landing__inner">
      <div class="joynure-hula-mechanism__intro">
        <p class="joynure-hula-landing__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        <h2 class="joynure-hula-landing__title joynure-hula-landing__title--center">{{ section.settings.heading | escape }}</h2>
        <p class="joynure-hula-landing__lede joynure-hula-landing__lede--center">{{ section.settings.lede | escape }}</p>
      </div>
      <div class="joynure-hula-mechanism__grid">
        <div class="joynure-hula-card-3d joynure-hula-mechanism__visual">
          <div class="joynure-hula-card-3d__media">
            {% render 'joynure-hula-media',
              product: product,
              setting_image: section.settings.image,
              asset_file: section.settings.asset_file,
              media_id: section.settings.media_id,
              alt: section.settings.heading,
              class: 'joynure-hula-landing__media',
              loading: 'lazy',
              sizes: '(min-width: 990px) 50vw, 100vw'
            %}
          </div>
        </div>
        <div class="joynure-hula-mechanism__cards">
          {% for i in (1..4) %}
            {% liquid
              assign tk = 'i' | append: i | append: '_title'
              assign xk = 'i' | append: i | append: '_text'
            %}
            <article class="joynure-hula-card-3d joynure-hula-mechanism__card">
              <div class="joynure-hula-card-3d__body">
                <h3>{{ section.settings[tk] | escape }}</h3>
                <p>{{ section.settings[xk] | escape }}</p>
              </div>
            </article>
          {% endfor %}
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "JOYNURE Pet mechanism",
  "tag": "section",
  "class": "joynure-hula-landing-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "2-in-1 design" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built to Collect — Then Self-Clean" },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Supporting copy",
      "default": "A fabric-friendly brush surface plus a twist-to-clean chamber for everyday pet hair cleanup."
    },
    { "type": "image_picker", "id": "image", "label": "Detail image" },
    { "type": "text", "id": "asset_file", "label": "Theme asset", "default": "pet-mechanism-hero.jpg" },
    { "type": "text", "id": "media_id", "label": "Fallback media ID", "default": "45015235166481" },
    { "type": "text", "id": "i1_title", "label": "Point 1 title", "default": "Electrostatic brush surface" },
    { "type": "textarea", "id": "i1_text", "label": "Point 1 text", "default": "Lifts pet hair and lint from clothing, upholstery, and bedding." },
    { "type": "text", "id": "i2_title", "label": "Point 2 title", "default": "Twist-to-clean action" },
    { "type": "textarea", "id": "i2_text", "label": "Point 2 text", "default": "Rotate the handle to clear the brush into the collection chamber." },
    { "type": "text", "id": "i3_title", "label": "Point 3 title", "default": "Easy empty release" },
    { "type": "textarea", "id": "i3_text", "label": "Point 3 text", "default": "Open the chamber and empty debris without sticky sheets." },
    { "type": "text", "id": "i4_title", "label": "Point 4 title", "default": "Compact everyday size" },
    { "type": "textarea", "id": "i4_text", "label": "Point 4 text", "default": "About 7.2 in tall — easy to store at home or keep in the car." }
  ],
  "presets": [{ "name": "JOYNURE Pet mechanism" }]
}
{% endschema %}
