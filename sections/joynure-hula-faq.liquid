{%- capture enabled_flag -%}
  {%- render 'joynure-hula-landing-enabled', product: product -%}
{%- endcapture -%}
{%- if enabled_flag == 'true' -%}
  {{ 'joynure-hula-landing.css' | asset_url | stylesheet_tag }}
  <section class="joynure-hula-landing joynure-hula-landing__section joynure-hula-landing__section--blush" {{ section.shopify_attributes }}>
    <div class="joynure-hula-landing__inner">
      <h2 class="joynure-hula-landing__title joynure-hula-landing__title--center">{{ section.settings.heading | escape }}</h2>
      <div class="joynure-hula-faq__list">
        {% for i in (1..8) %}
          {% liquid
            assign qk = 'q' | append: i
            assign ak = 'a' | append: i
            assign q = section.settings[qk]
            assign a = section.settings[ak]
          %}
          {% if q != blank %}
            <details class="joynure-hula-faq__item">
              <summary>{{ q | escape }}</summary>
              <p>{{ a | escape }}</p>
            </details>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "JOYNURE Hula FAQ",
  "tag": "section",
  "class": "joynure-hula-landing-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions?" },
    { "type": "text", "id": "q1", "label": "Q1", "default": "How do I choose the right size?" },
    { "type": "textarea", "id": "a1", "label": "A1", "default": "Start with enough sections for a snug but comfortable waist fit, then add or remove sections as needed. Maximum fit is approximately 115 cm / 45 in." },
    { "type": "text", "id": "q2", "label": "Q2", "default": "How do I assemble the hoop?" },
    { "type": "textarea", "id": "a2", "label": "A2", "default": "Connect the detachable sections into a ring around your waist until the fit feels secure, then attach the cord and weighted gravity ball to the track." },
    { "type": "text", "id": "q3", "label": "Q3", "default": "How does the weighted ball work?" },
    { "type": "textarea", "id": "a3", "label": "A3", "default": "The ball attaches to a sliding piece on the outer track. Steady waist movement guides the ball around the hoop." },
    { "type": "text", "id": "q4", "label": "Q4", "default": "Can I adjust the cord length?" },
    { "type": "textarea", "id": "a4", "label": "A4", "default": "Yes. Adjust the cord to a radius that feels comfortable for your space and experience level." },
    { "type": "text", "id": "q5", "label": "Q5", "default": "Which colors are available?" },
    { "type": "textarea", "id": "a5", "label": "A5", "default": "Pink, Purple, and Blue." },
    { "type": "text", "id": "q6", "label": "Q6", "default": "Is it suitable for beginners?" },
    { "type": "textarea", "id": "a6", "label": "A6", "default": "Yes. Begin slowly, keep a comfortable cord length, and build a steady rhythm over time." },
    { "type": "text", "id": "q7", "label": "Q7", "default": "How should I store it?" },
    { "type": "textarea", "id": "a7", "label": "A7", "default": "Detach sections when needed for more compact storage at home." },
    { "type": "text", "id": "q8", "label": "Q8", "default": "What comes in the package?" },
    { "type": "textarea", "id": "a8", "label": "A8", "default": "An adjustable 24-section hoop, a weighted gravity ball, and an adjustable cord." }
  ],
  "presets": [{ "name": "JOYNURE Hula FAQ" }]
}
{% endschema %}
