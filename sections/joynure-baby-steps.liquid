{%- capture enabled_flag -%}
  {%- render 'joynure-baby-landing-enabled', product: product -%}
{%- endcapture -%}
{%- if enabled_flag == 'true' -%}
  {%- liquid
    assign is_mat = false
    if product.handle == 'portable-foldable-baby-changing-mat-waterproof-travel-changing-pad'
      assign is_mat = true
    endif
    if is_mat
      assign steps_heading = section.settings.heading_mat | default: section.settings.heading
      assign steps_lede = section.settings.lede_mat | default: 'Four simple moves from packed clutch to clean fold-away.'
    else
      assign steps_heading = section.settings.heading
      assign steps_lede = section.settings.lede
    endif
  -%}
  {{ 'joynure-hula-landing.css' | asset_url | stylesheet_tag }}
  <section class="joynure-hula-landing joynure-hula-landing__section joynure-hula-landing__section--wash" {{ section.shopify_attributes }}>
    <div class="joynure-hula-landing__inner">
      <h2 class="joynure-hula-landing__title joynure-hula-landing__title--center">{{ steps_heading | escape }}</h2>
      <p class="joynure-hula-landing__lede joynure-hula-landing__lede--center">{{ steps_lede | escape }}</p>
      <div class="joynure-hula-steps__grid joynure-hula-steps__grid--3d">
        {% for i in (1..4) %}
          {% liquid
            assign tkey = 't' | append: i | append: '_title'
            assign xkey = 't' | append: i | append: '_text'
            assign ikey = 'image_' | append: i
            assign mkey = 'media_id_' | append: i
            assign akey = 'asset_' | append: i
            assign title = section.settings[tkey]
            assign text = section.settings[xkey]
            assign img = section.settings[ikey]
            assign mid = section.settings[mkey]
            assign asset = section.settings[akey]
            assign num = i | prepend: '0'
            if is_mat
              case i
                when 1
                  assign title = 'Unfold the Mat'
                  assign text = 'Open the clutch into a full padded changing surface.'
                when 2
                  assign title = 'Change on Padding'
                  assign text = 'Lay baby on the soft core — safer than hard public surfaces.'
                when 3
                  assign title = 'Wipe Clean'
                  assign text = 'Wipe the waterproof top after the change.'
                when 4
                  assign title = 'Fold & Pack'
                  assign text = 'Fold back into a clutch and return it to your bag.'
              endcase
            endif
          %}
          <article class="joynure-hula-card-3d joynure-hula-steps__card">
            <div class="joynure-hula-card-3d__media">
              {% render 'joynure-hula-media',
                product: product,
                setting_image: img,
                asset_file: asset,
                media_id: mid,
                alt: title,
                class: 'joynure-hula-landing__media',
                loading: 'lazy',
                sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 100vw'
              %}
            </div>
            <div class="joynure-hula-card-3d__body joynure-hula-steps__body">
              <p class="joynure-hula-how__num">{{ num }}</p>
              <h3>{{ title | escape }}</h3>
              <p>{{ text | escape }}</p>
            </div>
          </article>
        {% endfor %}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "JOYNURE Baby four steps",
  "tag": "section",
  "class": "joynure-hula-landing-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready in Four Simple Steps" },
    { "type": "text", "id": "heading_mat", "label": "Heading (mat)", "default": "Ready in Four Simple Steps" },
    { "type": "textarea", "id": "lede", "label": "Supporting copy", "default": "A calm nail routine parents can repeat at bedtime or bath time." },
    { "type": "textarea", "id": "lede_mat", "label": "Supporting copy (mat)", "default": "Four simple moves from packed clutch to clean fold-away." },
    { "type": "image_picker", "id": "image_1", "label": "Step 1 image" },
    { "type": "text", "id": "asset_1", "label": "Step 1 theme asset", "default": "baby-steps-1.jpg" },
    { "type": "text", "id": "media_id_1", "label": "Step 1 media ID" },
    { "type": "text", "id": "t1_title", "label": "Step 1 title", "default": "Choose a Soft Pad" },
    { "type": "textarea", "id": "t1_text", "label": "Step 1 text", "default": "Match the pad to your baby’s age stage before you start." },
    { "type": "image_picker", "id": "image_2", "label": "Step 2 image" },
    { "type": "text", "id": "asset_2", "label": "Step 2 theme asset", "default": "baby-steps-2.jpg" },
    { "type": "text", "id": "media_id_2", "label": "Step 2 media ID" },
    { "type": "text", "id": "t2_title", "label": "Step 2 title", "default": "Turn On the Light" },
    { "type": "textarea", "id": "t2_text", "label": "Step 2 text", "default": "Use the LED to see nail edges on tiny fingers and toes." },
    { "type": "image_picker", "id": "image_3", "label": "Step 3 image" },
    { "type": "text", "id": "asset_3", "label": "Step 3 theme asset", "default": "baby-steps-3.jpg" },
    { "type": "text", "id": "media_id_3", "label": "Step 3 media ID" },
    { "type": "text", "id": "t3_title", "label": "Step 3 title", "default": "Guide Gently" },
    { "type": "textarea", "id": "t3_text", "label": "Step 3 text", "default": "Let the soft pad file the nail — no sharp clipper pressure." },
    { "type": "image_picker", "id": "image_4", "label": "Step 4 image" },
    { "type": "text", "id": "asset_4", "label": "Step 4 theme asset", "default": "baby-steps-4.jpg" },
    { "type": "text", "id": "media_id_4", "label": "Step 4 media ID" },
    { "type": "text", "id": "t4_title", "label": "Step 4 title", "default": "Store the Set" },
    { "type": "textarea", "id": "t4_text", "label": "Step 4 text", "default": "Keep pads and trimmer together for the next calm session." }
  ],
  "presets": [{ "name": "JOYNURE Baby four steps" }]
}
{% endschema %}
