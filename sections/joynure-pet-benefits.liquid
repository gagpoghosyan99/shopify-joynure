{%- capture enabled_flag -%}
  {%- render 'joynure-pet-landing-enabled', product: product -%}
{%- endcapture -%}
{%- if enabled_flag == 'true' -%}
  {{ 'joynure-hula-landing.css' | asset_url | stylesheet_tag }}
  <section class="joynure-hula-landing joynure-hula-benefits" {{ section.shopify_attributes }}>
    <div class="joynure-hula-landing__inner">
      <div class="joynure-hula-benefits__grid">
        <article class="joynure-hula-benefits__item">
          <svg class="joynure-hula-benefits__icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M4 12h16M8 8l-2 4 2 4M16 8l2 4-2 4"/>
          </svg>
          <p class="joynure-hula-benefits__label">{{ section.settings.b1_label | escape }}</p>
          <p class="joynure-hula-benefits__text">{{ section.settings.b1_text | escape }}</p>
        </article>
        <article class="joynure-hula-benefits__item">
          <svg class="joynure-hula-benefits__icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M5 12.5 9.5 17 19 7"/>
          </svg>
          <p class="joynure-hula-benefits__label">{{ section.settings.b2_label | escape }}</p>
          <p class="joynure-hula-benefits__text">{{ section.settings.b2_text | escape }}</p>
        </article>
        <article class="joynure-hula-benefits__item">
          <svg class="joynure-hula-benefits__icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
            <rect x="4" y="7" width="16" height="12" rx="2"/><path d="M8 7V5h8v2"/>
          </svg>
          <p class="joynure-hula-benefits__label">{{ section.settings.b3_label | escape }}</p>
          <p class="joynure-hula-benefits__text">{{ section.settings.b3_text | escape }}</p>
        </article>
        <article class="joynure-hula-benefits__item">
          <svg class="joynure-hula-benefits__icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
            <circle cx="12" cy="12" r="8"/><path d="M8 12h8"/>
          </svg>
          <p class="joynure-hula-benefits__label">{{ section.settings.b4_label | escape }}</p>
          <p class="joynure-hula-benefits__text">{{ section.settings.b4_text | escape }}</p>
        </article>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "JOYNURE Pet benefits",
  "tag": "section",
  "class": "joynure-hula-landing-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "b1_label", "label": "Benefit 1 label", "default": "Reusable, no sticky sheets" },
    { "type": "text", "id": "b1_text", "label": "Benefit 1 text", "default": "Collect pet hair and lint without disposable adhesive rolls." },
    { "type": "text", "id": "b2_label", "label": "Benefit 2 label", "default": "Self-cleaning chamber" },
    { "type": "text", "id": "b2_text", "label": "Benefit 2 text", "default": "Twist to clear the brush surface into the built-in collection chamber." },
    { "type": "text", "id": "b3_label", "label": "Benefit 3 label", "default": "Easy to empty" },
    { "type": "text", "id": "b3_text", "label": "Benefit 3 text", "default": "Press the release and empty debris without messy hand contact." },
    { "type": "text", "id": "b4_label", "label": "Benefit 4 label", "default": "Fabric-friendly design" },
    { "type": "text", "id": "b4_text", "label": "Benefit 4 text", "default": "Made for sofas, clothing, bedding, and everyday fabric surfaces." }
  ],
  "presets": [{ "name": "JOYNURE Pet benefits" }]
}
{% endschema %}
