{%- capture enabled_flag -%}
  {%- render 'joynure-pet-landing-enabled', product: product -%}
{%- endcapture -%}
{%- if enabled_flag == 'true' -%}
  {{ 'joynure-hula-landing.css' | asset_url | stylesheet_tag }}
  <section class="joynure-hula-landing joynure-hula-landing__section joynure-hula-landing__section--blush" {{ section.shopify_attributes }}>
    <div class="joynure-hula-landing__inner">
      <h2 class="joynure-hula-landing__title joynure-hula-landing__title--center">
        {{ section.settings.heading | escape }}
      </h2>
      <p class="joynure-hula-landing__lede joynure-hula-landing__lede--center">{{ section.settings.lede | escape }}</p>
      <div class="joynure-hula-difference__grid joynure-hula-reviews__grid">
        {% for i in (1..4) %}
          {% liquid
            assign quote_key = 'r' | append: i | append: '_quote'
            assign name_key = 'r' | append: i | append: '_name'
            assign meta_key = 'r' | append: i | append: '_meta'
            assign before_picker = 'before_image_' | append: i
            assign after_picker = 'after_image_' | append: i
            assign before_asset = 'before_asset_' | append: i
            assign after_asset = 'after_asset_' | append: i
            assign before_mid = 'before_media_id_' | append: i
            assign after_mid = 'after_media_id_' | append: i
          %}
          <article class="joynure-hula-card-3d joynure-hula-review-card">
            <div class="joynure-hula-review-card__ba" aria-label="Before and after photos">
              <figure class="joynure-hula-review-card__shot">
                <span class="joynure-hula-review-card__badge joynure-hula-review-card__badge--before">{{ section.settings.before_label | escape }}</span>
                <div class="joynure-hula-card-3d__media">
                  {% render 'joynure-hula-media',
                    product: product,
                    setting_image: section.settings[before_picker],
                    asset_file: section.settings[before_asset],
                    media_id: section.settings[before_mid],
                    alt: section.settings.before_label,
                    class: 'joynure-hula-landing__media',
                    loading: 'lazy',
                    sizes: '(min-width: 990px) 11vw, (min-width: 750px) 22vw, 44vw'
                  %}
                </div>
              </figure>
              <figure class="joynure-hula-review-card__shot">
                <span class="joynure-hula-review-card__badge joynure-hula-review-card__badge--after">{{ section.settings.after_label | escape }}</span>
                <div class="joynure-hula-card-3d__media">
                  {% render 'joynure-hula-media',
                    product: product,
                    setting_image: section.settings[after_picker],
                    asset_file: section.settings[after_asset],
                    media_id: section.settings[after_mid],
                    alt: section.settings.after_label,
                    class: 'joynure-hula-landing__media',
                    loading: 'lazy',
                    sizes: '(min-width: 990px) 11vw, (min-width: 750px) 22vw, 44vw'
                  %}
                </div>
              </figure>
            </div>
            <div class="joynure-hula-card-3d__body joynure-hula-review-card__body">
              <div class="joynure-hula-review-card__stars" aria-hidden="true">★★★★★</div>
              <p class="joynure-hula-review-card__quote">“{{ section.settings[quote_key] | escape }}”</p>
              <p class="joynure-hula-review-card__name">{{ section.settings[name_key] | escape }}</p>
              {% if section.settings[meta_key] != blank %}
                <p class="joynure-hula-review-card__meta">{{ section.settings[meta_key] | escape }}</p>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "JOYNURE Pet difference",
  "tag": "section",
  "class": "joynure-hula-landing-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "See the difference" },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Supporting copy",
      "default": "From hair-covered fabric to a fresher finish — reusable cleanup that fits real pet homes."
    },
    { "type": "text", "id": "before_label", "label": "Before label", "default": "Before" },
    { "type": "text", "id": "after_label", "label": "After label", "default": "After" },

    { "type": "header", "content": "Review 1" },
    { "type": "image_picker", "id": "before_image_1", "label": "Before image 1" },
    { "type": "text", "id": "before_asset_1", "label": "Before asset 1", "default": "pet-review-1-before.jpg" },
    { "type": "text", "id": "before_media_id_1", "label": "Before media ID 1" },
    { "type": "image_picker", "id": "after_image_1", "label": "After image 1" },
    { "type": "text", "id": "after_asset_1", "label": "After asset 1", "default": "pet-review-1-after.jpg" },
    { "type": "text", "id": "after_media_id_1", "label": "After media ID 1" },
    { "type": "textarea", "id": "r1_quote", "label": "Quote 1", "default": "Our sofa used to look permanently dusty with fur. A few swipes and it finally looks presentable again." },
    { "type": "text", "id": "r1_name", "label": "Name 1", "default": "Jordan P." },
    { "type": "text", "id": "r1_meta", "label": "Meta 1", "default": "Green · Sofa cleanup" },

    { "type": "header", "content": "Review 2" },
    { "type": "image_picker", "id": "before_image_2", "label": "Before image 2" },
    { "type": "text", "id": "before_asset_2", "label": "Before asset 2", "default": "pet-review-2-before.jpg" },
    { "type": "text", "id": "before_media_id_2", "label": "Before media ID 2" },
    { "type": "image_picker", "id": "after_image_2", "label": "After image 2" },
    { "type": "text", "id": "after_asset_2", "label": "After asset 2", "default": "pet-review-2-after.jpg" },
    { "type": "text", "id": "after_media_id_2", "label": "After media ID 2" },
    { "type": "textarea", "id": "r2_quote", "label": "Quote 2", "default": "I keep one by the coats. No more sticky lint-roll sheets in the trash every week." },
    { "type": "text", "id": "r2_name", "label": "Name 2", "default": "Samira L." },
    { "type": "text", "id": "r2_meta", "label": "Meta 2", "default": "Blue · Coats & clothing" },

    { "type": "header", "content": "Review 3" },
    { "type": "image_picker", "id": "before_image_3", "label": "Before image 3" },
    { "type": "text", "id": "before_asset_3", "label": "Before asset 3", "default": "pet-review-3-before.jpg" },
    { "type": "text", "id": "before_media_id_3", "label": "Before media ID 3" },
    { "type": "image_picker", "id": "after_image_3", "label": "After image 3" },
    { "type": "text", "id": "after_asset_3", "label": "After asset 3", "default": "pet-review-3-after.jpg" },
    { "type": "text", "id": "after_media_id_3", "label": "After media ID 3" },
    { "type": "textarea", "id": "r3_quote", "label": "Quote 3", "default": "Works on the car seats too. Hair comes up fast without leaving sticky residue." },
    { "type": "text", "id": "r3_name", "label": "Name 3", "default": "Chris M." },
    { "type": "text", "id": "r3_meta", "label": "Meta 3", "default": "White · Car seats" },

    { "type": "header", "content": "Review 4" },
    { "type": "image_picker", "id": "before_image_4", "label": "Before image 4" },
    { "type": "text", "id": "before_asset_4", "label": "Before asset 4", "default": "pet-review-4-before.jpg" },
    { "type": "text", "id": "before_media_id_4", "label": "Before media ID 4" },
    { "type": "image_picker", "id": "after_image_4", "label": "After image 4" },
    { "type": "text", "id": "after_asset_4", "label": "After asset 4", "default": "pet-review-4-after.jpg" },
    { "type": "text", "id": "after_media_id_4", "label": "After media ID 4" },
    { "type": "textarea", "id": "r4_quote", "label": "Quote 4", "default": "Bedding looked covered every morning. Now a quick pass keeps it looking fresh." },
    { "type": "text", "id": "r4_name", "label": "Name 4", "default": "Elena R." },
    { "type": "text", "id": "r4_meta", "label": "Meta 4", "default": "Pink · Bedding" }
  ],
  "presets": [{ "name": "JOYNURE Pet difference" }]
}
{% endschema %}
