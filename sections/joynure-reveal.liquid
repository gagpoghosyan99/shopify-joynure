{{ 'joynure-reveal.css' | asset_url | stylesheet_tag }}
<script src="{{ 'joynure-reveal.js' | asset_url }}" type="module"></script>

{%- liquid
  assign product = closest.product | default: product
  capture shop_handle
    render 'joynure-product-shop-collection', product: product
  endcapture
  assign shop_handle = shop_handle | strip

  assign heading = section.settings.heading
  assign description = section.settings.description
  assign before_label = section.settings.before_label | default: 'Before'
  assign after_label = section.settings.after_label | default: 'After'
  assign orientation = section.settings.orientation | default: 'horizontal'
  assign initial_position = section.settings.initial_position | default: 50
  assign show_labels = section.settings.show_labels

  assign before_image = section.settings.before_image
  assign after_image = section.settings.after_image
  assign before_src = ''
  assign after_src = ''
  assign before_alt = before_label
  assign after_alt = after_label

  if before_image != blank
    assign before_src = before_image | image_url: width: 1600
    assign before_alt = before_image.alt | default: before_label
  endif
  if after_image != blank
    assign after_src = after_image | image_url: width: 1600
    assign after_alt = after_image.alt | default: after_label
  endif

  # Category defaults when Theme Editor images are empty
  if before_src == blank or after_src == blank
    case shop_handle
      when 'fitness-health'
        if before_src == blank
          assign before_src = 'joynure-reveal-before-fitness.jpg' | asset_url
          assign before_alt = 'Before — at-home fitness routine'
        endif
        if after_src == blank
          assign after_src = 'joynure-reveal-after-fitness.jpg' | asset_url
          assign after_alt = 'After — active hula hoop workout at home'
        endif
        if heading == blank
          assign heading = 'See the difference'
        endif
        if description == blank
          assign description = 'Drag to compare — a simple way to picture a more engaging at-home workout routine.'
        endif
      when 'pet-care'
        if before_src == blank
          assign before_src = 'joynure-reveal-before-pet.jpg' | asset_url
          assign before_alt = 'Before — pet hair on furniture'
        endif
        if after_src == blank
          assign after_src = 'joynure-reveal-after-pet.jpg' | asset_url
          assign after_alt = 'After — cleaner sofa and calmer pet care'
        endif
        if heading == blank
          assign heading = 'See the difference'
        endif
        if description == blank
          assign description = 'Drag to compare everyday pet-care cleanup before and after.'
        endif
      when 'baby-care'
        if before_src == blank
          assign before_src = 'joynure-reveal-before-baby.jpg' | asset_url
          assign before_alt = 'Before — cluttered nursery routine'
        endif
        if after_src == blank
          assign after_src = 'joynure-reveal-after-baby.jpg' | asset_url
          assign after_alt = 'After — calmer baby care routine'
        endif
        if heading == blank
          assign heading = 'See the difference'
        endif
        if description == blank
          assign description = 'Drag to compare a calmer, more organized baby-care moment.'
        endif
      else
        if before_src == blank
          assign before_src = 'joynure-reveal-before-fitness.jpg' | asset_url
        endif
        if after_src == blank
          assign after_src = 'joynure-reveal-after-fitness.jpg' | asset_url
        endif
        if heading == blank
          assign heading = 'See the difference'
        endif
        if description == blank
          assign description = 'Drag the slider to compare before and after.'
        endif
    endcase
  endif
-%}

<section
  class="joynure-reveal-section"
  style="
    --joynure-reveal-pad-top: {{ section.settings.padding-block-start }}px;
    --joynure-reveal-pad-bottom: {{ section.settings.padding-block-end }}px;
    padding-block: var(--joynure-reveal-pad-top) var(--joynure-reveal-pad-bottom);
  "
  {{ section.shopify_attributes }}
>
  <joynure-reveal
    class="joynure-reveal"
    data-orientation="{{ orientation }}"
    data-initial-position="{{ initial_position }}"
  >
    {% if heading != blank or description != blank %}
      <div class="joynure-reveal__header">
        {% if heading != blank %}
          <h2 class="joynure-reveal__heading">{{ heading | escape }}</h2>
        {% endif %}
        {% if description != blank %}
          <p class="joynure-reveal__description">{{ description | escape }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div
      class="joynure-reveal__frame"
      data-joynure-reveal-frame
      data-orientation="{{ orientation }}"
      role="slider"
      tabindex="0"
      aria-label="Before and after comparison"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="{{ initial_position }}"
    >
      <div class="joynure-reveal__layer joynure-reveal__after">
        <img
          src="{{ after_src }}"
          alt="{{ after_alt | escape }}"
          width="1600"
          height="900"
          loading="lazy"
          decoding="async"
        >
      </div>

      <div class="joynure-reveal__layer joynure-reveal__before" data-joynure-reveal-before>
        <img
          src="{{ before_src }}"
          alt="{{ before_alt | escape }}"
          width="1600"
          height="900"
          loading="lazy"
          decoding="async"
        >
      </div>

      <div class="joynure-reveal__divider" data-joynure-reveal-divider aria-hidden="true">
        <span class="joynure-reveal__handle">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M9 6v12M15 6v12" stroke-linecap="round"/>
          </svg>
        </span>
      </div>

      {% if show_labels %}
        <span class="joynure-reveal__label joynure-reveal__label--before">{{ before_label | escape }}</span>
        <span class="joynure-reveal__label joynure-reveal__label--after">{{ after_label | escape }}</span>
      {% endif %}
    </div>
  </joynure-reveal>
</section>

{% schema %}
{
  "name": "JOYNURE before/after",
  "tag": "section",
  "class": "joynure-reveal-section-wrapper",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See the difference"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Drag the slider to compare before and after."
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Before image",
      "info": "Optional. If empty, category defaults are used."
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After image",
      "info": "Optional. If empty, category defaults are used."
    },
    {
      "type": "text",
      "id": "before_label",
      "label": "Before label",
      "default": "Before"
    },
    {
      "type": "text",
      "id": "after_label",
      "label": "After label",
      "default": "After"
    },
    {
      "type": "select",
      "id": "orientation",
      "label": "Orientation",
      "options": [
        { "value": "horizontal", "label": "Horizontal" },
        { "value": "vertical", "label": "Vertical" }
      ],
      "default": "horizontal"
    },
    {
      "type": "range",
      "id": "initial_position",
      "label": "Initial slider position",
      "min": 10,
      "max": 90,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "checkbox",
      "id": "show_labels",
      "label": "Show labels",
      "default": true
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "JOYNURE before/after",
      "category": "JOYNURE"
    }
  ]
}
{% endschema %}
