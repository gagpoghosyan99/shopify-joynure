{{ 'joynure-reveal.css' | asset_url | stylesheet_tag }}
<script src="{{ 'joynure-reveal.js' | asset_url }}" type="module"></script>

{%- liquid
  assign product = closest.product | default: product
  capture shop_handle
    render 'joynure-product-shop-collection', product: product
  endcapture
  assign shop_handle = shop_handle | strip

  assign heading = section.settings.heading
  assign description = section.settings.description
  assign before_label = section.settings.before_label | default: 'Before'
  assign after_label = section.settings.after_label | default: 'After'
  assign orientation = section.settings.orientation | default: 'horizontal'
  assign initial_position = section.settings.initial_position | default: 50
  assign show_labels = section.settings.show_labels

  assign before_image = section.settings.before_image
  assign after_image = section.settings.after_image
  assign before_src = ''
  assign after_src = ''
  assign before_alt = before_label
  assign after_alt = after_label

  if before_image != blank
    assign before_src = before_image | image_url: width: 900
    assign before_alt = before_image.alt | default: before_label
  endif
  if after_image != blank
    assign after_src = after_image | image_url: width: 900
    assign after_alt = after_image.alt | default: after_label
  endif

  if before_src == blank or after_src == blank
    case shop_handle
      when 'fitness-health'
        if before_src == blank
          assign before_src = 'joynure-reveal-before-fitness.jpg' | asset_url
          assign before_alt = 'Before — at-home fitness routine'
        endif
        if after_src == blank
          assign after_src = 'joynure-reveal-after-fitness.jpg' | asset_url
          assign after_alt = 'After — active hula hoop workout at home'
        endif
      when 'pet-care'
        if before_src == blank
          assign before_src = 'joynure-reveal-before-pet.jpg' | asset_url
          assign before_alt = 'Before — pet hair on furniture'
        endif
        if after_src == blank
          assign after_src = 'joynure-reveal-after-pet.jpg' | asset_url
          assign after_alt = 'After — cleaner sofa and calmer pet care'
        endif
      when 'baby-care'
        if before_src == blank
          assign before_src = 'joynure-reveal-before-baby.jpg' | asset_url
          assign before_alt = 'Before — cluttered nursery routine'
        endif
        if after_src == blank
          assign after_src = 'joynure-reveal-after-baby.jpg' | asset_url
          assign after_alt = 'After — calmer baby care routine'
        endif
      else
        if before_src == blank
          assign before_src = 'joynure-reveal-before-fitness.jpg' | asset_url
        endif
        if after_src == blank
          assign after_src = 'joynure-reveal-after-fitness.jpg' | asset_url
        endif
    endcase
  endif

  if heading == blank
    assign heading = 'See the difference'
  endif
  if description == blank
    assign description = 'Real customer results — drag each card to compare, then swipe the row.'
  endif

  case shop_handle
    when 'pet-care'
      assign default_reviews = 'Maya R.|Our dark sofa was covered in fur every single day — one week with this and it finally looks clean again.|Jordan P.|I was lint-rolling my coats forever. Now a few swipes and the hair is gone.|Sam T.|Dog hair in the car used to embarrass me. Guests actually noticed it was clean this time.|Alex K.|Cat hair on the bedding drove me crazy. Drag the slider — the difference is real.'
    when 'baby-care'
      assign default_reviews = 'Priya S.|Nights feel calmer and our setup finally makes sense.|Elena M.|Cleanup is faster and the nursery feels less chaotic.|Noah L.|Wish we had this earlier — the difference is obvious.|Harper C.|Gentle, practical, and the results speak for themselves.'
    else
      assign default_reviews = 'Ava M.|Two weeks in and my core feels stronger already.|Chris D.|I actually look forward to workouts at home now.|Lena K.|Drag the slider — the difference is wild.|Marcus T.|Fits my apartment routine and keeps me consistent.'
  endcase

  assign review_pairs = default_reviews | split: '|'
-%}

<section
  class="joynure-reveal-section"
  style="
    --joynure-reveal-pad-top: {{ section.settings.padding-block-start }}px;
    --joynure-reveal-pad-bottom: {{ section.settings.padding-block-end }}px;
    padding-block: var(--joynure-reveal-pad-top) var(--joynure-reveal-pad-bottom);
  "
  {{ section.shopify_attributes }}
>
  <div class="joynure-reveal">
    {% if heading != blank or description != blank %}
      <div class="joynure-reveal__header">
        {% if heading != blank %}
          <h2 class="joynure-reveal__heading">{{ heading | escape }}</h2>
        {% endif %}
        {% if description != blank %}
          <p class="joynure-reveal__description">{{ description | escape }}</p>
        {% endif %}
      </div>
    {% endif %}

    <joynure-reveal-carousel class="joynure-reveal-carousel" data-joynure-reveal-carousel>
      <button
        type="button"
        class="joynure-reveal-carousel__nav joynure-reveal-carousel__nav--prev"
        data-joynure-reveal-prev
        aria-label="Previous reviews"
      >
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M12.5 4.5 7 10l5.5 5.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <div
        class="joynure-reveal-carousel__track"
        data-joynure-reveal-track
        tabindex="0"
        role="region"
        aria-label="Customer before and after reviews"
      >
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- liquid
              assign card_before_src = before_src
              assign card_after_src = after_src
              assign card_before_alt = before_alt
              assign card_after_alt = after_alt

              # Unique default before/after per card so the carousel is not identical
              assign card_slot = forloop.index
              if card_slot > 4
                assign card_slot = forloop.index0 | modulo: 4 | plus: 1
              endif
              if shop_handle == 'fitness-health' or shop_handle == blank
                assign card_before_src = 'joynure-reveal-before-fitness-' | append: card_slot | append: '.jpg' | asset_url
                assign card_after_src = 'joynure-reveal-after-fitness-' | append: card_slot | append: '.jpg' | asset_url
                assign card_before_alt = 'Before — customer story ' | append: card_slot
                assign card_after_alt = 'After — customer story ' | append: card_slot
              elsif shop_handle == 'pet-care'
                assign card_before_src = 'joynure-reveal-before-pet-' | append: card_slot | append: '.jpg' | asset_url
                assign card_after_src = 'joynure-reveal-after-pet-' | append: card_slot | append: '.jpg' | asset_url
                assign card_before_alt = 'Before — pet care story ' | append: card_slot
                assign card_after_alt = 'After — pet care story ' | append: card_slot
              endif

              if block.settings.before_image != blank
                assign card_before_src = block.settings.before_image | image_url: width: 900
                assign card_before_alt = block.settings.before_image.alt | default: before_label
              endif
              if block.settings.after_image != blank
                assign card_after_src = block.settings.after_image | image_url: width: 900
                assign card_after_alt = block.settings.after_image.alt | default: after_label
              endif

              assign author_index = forloop.index0 | times: 2
              assign quote_index = author_index | plus: 1
              assign review_author = review_pairs[author_index]
              assign review_quote = review_pairs[quote_index]
              # Fitness keeps theme-editor copy when set; pet/baby always use category stories
              if shop_handle == 'fitness-health' or shop_handle == blank
                if block.settings.author != blank
                  assign review_author = block.settings.author
                endif
                if block.settings.quote != blank
                  assign review_quote = block.settings.quote
                endif
              endif
              assign review_rating = block.settings.rating | default: 5
            -%}
            <article class="joynure-reveal-card" {{ block.shopify_attributes }}>
              <joynure-reveal
                class="joynure-reveal-card__slider"
                data-orientation="{{ orientation }}"
                data-initial-position="{{ initial_position }}"
              >
                <div
                  class="joynure-reveal__frame"
                  data-joynure-reveal-frame
                  data-orientation="{{ orientation }}"
                  role="slider"
                  tabindex="0"
                  aria-label="Before and after comparison"
                  aria-valuemin="0"
                  aria-valuemax="100"
                  aria-valuenow="{{ initial_position }}"
                >
                  <div class="joynure-reveal__layer joynure-reveal__after">
                    <img
                      src="{{ card_after_src }}"
                      alt="{{ card_after_alt | escape }}"
                      width="900"
                      height="900"
                      loading="lazy"
                      decoding="async"
                    >
                  </div>
                  <div class="joynure-reveal__layer joynure-reveal__before" data-joynure-reveal-before>
                    <img
                      src="{{ card_before_src }}"
                      alt="{{ card_before_alt | escape }}"
                      width="900"
                      height="900"
                      loading="lazy"
                      decoding="async"
                    >
                  </div>
                  <div class="joynure-reveal__divider" data-joynure-reveal-divider aria-hidden="true">
                    <span class="joynure-reveal__handle" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" aria-hidden="true">
                        <path d="M14.5 6.5 9 12l5.5 5.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M9.5 6.5 15 12l-5.5 5.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                  </div>
                  {% if show_labels %}
                    <span class="joynure-reveal__label joynure-reveal__label--before">{{ before_label | escape }}</span>
                    <span class="joynure-reveal__label joynure-reveal__label--after">{{ after_label | escape }}</span>
                  {% endif %}
                </div>
              </joynure-reveal>

              <div class="joynure-reveal-card__review">
                <div class="joynure-reveal-card__stars" aria-label="{{ review_rating }} out of 5 stars">
                  {%- for i in (1..5) -%}
                    <span class="joynure-reveal-card__star{% if i > review_rating %} joynure-reveal-card__star--empty{% endif %}" aria-hidden="true">★</span>
                  {%- endfor -%}
                </div>
                {% if review_quote != blank %}
                  <blockquote class="joynure-reveal-card__quote">“{{ review_quote | escape }}”</blockquote>
                {% endif %}
                {% if review_author != blank %}
                  <cite class="joynure-reveal-card__author">{{ review_author | escape }}</cite>
                {% endif %}
              </div>
            </article>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (0..3) -%}
            {%- liquid
              assign author_index = i | times: 2
              assign quote_index = author_index | plus: 1
              assign review_author = review_pairs[author_index]
              assign review_quote = review_pairs[quote_index]
              assign card_slot = i | plus: 1
              assign card_before_src = before_src
              assign card_after_src = after_src
              if shop_handle == 'fitness-health' or shop_handle == blank
                assign card_before_src = 'joynure-reveal-before-fitness-' | append: card_slot | append: '.jpg' | asset_url
                assign card_after_src = 'joynure-reveal-after-fitness-' | append: card_slot | append: '.jpg' | asset_url
              elsif shop_handle == 'pet-care'
                assign card_before_src = 'joynure-reveal-before-pet-' | append: card_slot | append: '.jpg' | asset_url
                assign card_after_src = 'joynure-reveal-after-pet-' | append: card_slot | append: '.jpg' | asset_url
              endif
            -%}
            <article class="joynure-reveal-card">
              <joynure-reveal
                class="joynure-reveal-card__slider"
                data-orientation="{{ orientation }}"
                data-initial-position="{{ initial_position }}"
              >
                <div
                  class="joynure-reveal__frame"
                  data-joynure-reveal-frame
                  data-orientation="{{ orientation }}"
                  role="slider"
                  tabindex="0"
                  aria-label="Before and after comparison"
                  aria-valuemin="0"
                  aria-valuemax="100"
                  aria-valuenow="{{ initial_position }}"
                >
                  <div class="joynure-reveal__layer joynure-reveal__after">
                    <img
                      src="{{ card_after_src }}"
                      alt="After — {{ review_author | escape }}"
                      width="900"
                      height="900"
                      loading="lazy"
                      decoding="async"
                    >
                  </div>
                  <div class="joynure-reveal__layer joynure-reveal__before" data-joynure-reveal-before>
                    <img
                      src="{{ card_before_src }}"
                      alt="Before — {{ review_author | escape }}"
                      width="900"
                      height="900"
                      loading="lazy"
                      decoding="async"
                    >
                  </div>
                  <div class="joynure-reveal__divider" data-joynure-reveal-divider aria-hidden="true">
                    <span class="joynure-reveal__handle" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" aria-hidden="true">
                        <path d="M14.5 6.5 9 12l5.5 5.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M9.5 6.5 15 12l-5.5 5.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                  </div>
                  {% if show_labels %}
                    <span class="joynure-reveal__label joynure-reveal__label--before">{{ before_label | escape }}</span>
                    <span class="joynure-reveal__label joynure-reveal__label--after">{{ after_label | escape }}</span>
                  {% endif %}
                </div>
              </joynure-reveal>

              <div class="joynure-reveal-card__review">
                <div class="joynure-reveal-card__stars" aria-label="5 out of 5 stars">
                  {%- for s in (1..5) -%}
                    <span class="joynure-reveal-card__star" aria-hidden="true">★</span>
                  {%- endfor -%}
                </div>
                <blockquote class="joynure-reveal-card__quote">“{{ review_quote | escape }}”</blockquote>
                <cite class="joynure-reveal-card__author">{{ review_author | escape }}</cite>
              </div>
            </article>
          {%- endfor -%}
        {%- endif -%}
      </div>

      <button
        type="button"
        class="joynure-reveal-carousel__nav joynure-reveal-carousel__nav--next"
        data-joynure-reveal-next
        aria-label="Next reviews"
      >
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M7.5 4.5 13 10l-5.5 5.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </joynure-reveal-carousel>
  </div>
</section>

{% schema %}
{
  "name": "JOYNURE before/after",
  "tag": "section",
  "class": "joynure-reveal-section-wrapper",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See the difference"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Real customer results — drag each card to compare, then swipe the row."
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Default before image",
      "info": "Used when a review card has no before image of its own."
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "Default after image",
      "info": "Used when a review card has no after image of its own."
    },
    {
      "type": "text",
      "id": "before_label",
      "label": "Before label",
      "default": "Before"
    },
    {
      "type": "text",
      "id": "after_label",
      "label": "After label",
      "default": "After"
    },
    {
      "type": "select",
      "id": "orientation",
      "label": "Orientation",
      "options": [
        { "value": "horizontal", "label": "Horizontal" },
        { "value": "vertical", "label": "Vertical" }
      ],
      "default": "horizontal"
    },
    {
      "type": "range",
      "id": "initial_position",
      "label": "Initial slider position",
      "min": 10,
      "max": 90,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "checkbox",
      "id": "show_labels",
      "label": "Show labels",
      "default": true
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "review_card",
      "name": "Review card",
      "settings": [
        {
          "type": "text",
          "id": "author",
          "label": "Customer name",
          "default": "Ava M."
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Customer review",
          "default": "Two weeks in and my core feels stronger already."
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Star rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "image_picker",
          "id": "before_image",
          "label": "Before image"
        },
        {
          "type": "image_picker",
          "id": "after_image",
          "label": "After image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "JOYNURE before/after",
      "category": "JOYNURE",
      "blocks": [
        {
          "type": "review_card",
          "settings": {
            "author": "Ava M.",
            "quote": "Two weeks in and my core feels stronger already.",
            "rating": 5
          }
        },
        {
          "type": "review_card",
          "settings": {
            "author": "Chris D.",
            "quote": "I actually look forward to workouts at home now.",
            "rating": 5
          }
        },
        {
          "type": "review_card",
          "settings": {
            "author": "Lena K.",
            "quote": "Drag the slider — the difference is wild.",
            "rating": 5
          }
        },
        {
          "type": "review_card",
          "settings": {
            "author": "Marcus T.",
            "quote": "Fits my apartment routine and keeps me consistent.",
            "rating": 5
          }
        }
      ]
    }
  ]
}
{% endschema %}
