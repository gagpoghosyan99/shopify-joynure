{{ 'joynure-collection-hero.css' | asset_url | stylesheet_tag }}

{% liquid
  assign hero_title = collection.title
  assign hero_subtitle = collection.description
  assign hero_image = collection.image
  assign has_image = false
  if hero_image != blank
    assign has_image = true
  endif

  assign show_count = section.settings.show_product_count
  assign product_count = collection.products_count | default: 0
%}

<section
  class="joynure-collection-hero{% if has_image %} joynure-collection-hero--with-media{% else %} joynure-collection-hero--text-only{% endif %}"
  style="
    --joynure-collection-hero-bg: {{ section.settings.background }};
    --joynure-collection-hero-text: {{ section.settings.text_color }};
    --joynure-collection-hero-accent: {{ section.settings.accent_color }};
    --joynure-collection-hero-muted: {{ section.settings.muted_color }};
  "
  {{ section.shopify_attributes }}
>
  <div class="joynure-collection-hero__inner page-width-normal">
    <div class="joynure-collection-hero__copy">
      {% if section.settings.eyebrow != blank %}
        <p class="joynure-collection-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      <h1 class="joynure-collection-hero__title">{{ hero_title | escape }}</h1>

      {% if hero_subtitle != blank %}
        <div class="joynure-collection-hero__subtitle rte">
          {{ hero_subtitle }}
        </div>
      {% endif %}

      {% if show_count and product_count > 0 %}
        <p class="joynure-collection-hero__meta">
          {% if product_count == 1 %}
            1 product
          {% else %}
            {{ product_count }} products
          {% endif %}
        </p>
      {% endif %}
    </div>

    {% if has_image %}
      <div class="joynure-collection-hero__media">
        {{
          hero_image
          | image_url: width: 1600
          | image_tag:
            class: 'joynure-collection-hero__image',
            widths: '480, 720, 960, 1200, 1600',
            sizes: '(min-width: 900px) 42vw, 100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: hero_title
        }}
      </div>
    {% else %}
      <div class="joynure-collection-hero__accent" aria-hidden="true">
        <span class="joynure-collection-hero__accent-orb"></span>
        <span class="joynure-collection-hero__accent-rule"></span>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "JOYNURE collection hero",
  "tag": "section",
  "class": "joynure-collection-hero-section",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop the collection",
      "info": "Optional label above the title. Leave blank to hide."
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show product count",
      "default": false,
      "info": "Uses the Shopify collection product count (not split-card count)."
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#FFF8F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Title color",
      "default": "#24312E"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Subtitle color",
      "default": "#5B6662"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#FF7A68"
    }
  ],
  "presets": [
    {
      "name": "JOYNURE collection hero",
      "category": "JOYNURE"
    }
  ]
}
{% endschema %}
