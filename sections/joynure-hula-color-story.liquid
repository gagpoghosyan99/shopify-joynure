{%- capture enabled_flag -%}
  {%- render 'joynure-hula-landing-enabled', product: product -%}
{%- endcapture -%}
{%- if enabled_flag == 'true' -%}
  {{ 'joynure-hula-landing.css' | asset_url | stylesheet_tag }}
  <section class="joynure-hula-landing joynure-hula-landing__section" {{ section.shopify_attributes }}>
    <div class="joynure-hula-landing__inner">
      <h2 class="joynure-hula-landing__title joynure-hula-landing__title--center">{{ section.settings.heading | escape }}</h2>
      <p class="joynure-hula-landing__lede joynure-hula-landing__lede--center">{{ section.settings.lede | escape }}</p>
      <p class="joynure-hula-demo-note" style="text-align:center;margin-bottom:1.25rem;">
        {{ section.settings.demo_note | escape }}
      </p>
      <div class="joynure-hula-colors__grid">
        {% for color in (1..3) %}
          {% liquid
            case color
              when 1
                assign name = section.settings.pink_title
                assign text = section.settings.pink_text
                assign img = section.settings.pink_image
                assign mid = section.settings.pink_media_id
              when 2
                assign name = section.settings.purple_title
                assign text = section.settings.purple_text
                assign img = section.settings.purple_image
                assign mid = section.settings.purple_media_id
              when 3
                assign name = section.settings.blue_title
                assign text = section.settings.blue_text
                assign img = section.settings.blue_image
                assign mid = section.settings.blue_media_id
            endcase
          %}
          <article class="joynure-hula-colors__card">
            {% render 'joynure-hula-media',
              product: product,
              setting_image: img,
              media_id: mid,
              alt: name,
              class: 'joynure-hula-landing__media',
              loading: 'lazy',
              sizes: '(min-width: 750px) 33vw, 80vw'
            %}
            <div class="joynure-hula-colors__meta">
              <h3>{{ name | escape }}</h3>
              <p>{{ text | escape }}</p>
            </div>
          </article>
        {% endfor %}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "JOYNURE Hula color story",
  "tag": "section",
  "class": "joynure-hula-landing-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find Your Color" },
    { "type": "textarea", "id": "lede", "label": "Supporting copy", "default": "Three finishes designed for the same adjustable smart hoop experience." },
    { "type": "text", "id": "demo_note", "label": "Content note", "default": "Product demonstration photography — not customer testimonials." },
    { "type": "image_picker", "id": "pink_image", "label": "Pink image" },
    { "type": "text", "id": "pink_media_id", "label": "Pink media ID", "default": "45010727797009" },
    { "type": "text", "id": "pink_title", "label": "Pink title", "default": "Pink" },
    { "type": "textarea", "id": "pink_text", "label": "Pink text", "default": "A bright everyday finish for home movement sessions." },
    { "type": "image_picker", "id": "purple_image", "label": "Purple image" },
    { "type": "text", "id": "purple_media_id", "label": "Purple media ID", "default": "45011048595729" },
    { "type": "text", "id": "purple_title", "label": "Purple title", "default": "Purple" },
    { "type": "textarea", "id": "purple_text", "label": "Purple text", "default": "A bold option for a more expressive home-fitness look." },
    { "type": "image_picker", "id": "blue_image", "label": "Blue image" },
    { "type": "text", "id": "blue_media_id", "label": "Blue media ID", "default": "45011048562961" },
    { "type": "text", "id": "blue_title", "label": "Blue title", "default": "Blue" },
    { "type": "textarea", "id": "blue_text", "label": "Blue text", "default": "A clean, calm finish that fits quietly into living spaces." }
  ],
  "presets": [{ "name": "JOYNURE Hula color story" }]
}
{% endschema %}
