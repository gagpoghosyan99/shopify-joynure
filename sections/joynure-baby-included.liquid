{%- capture enabled_flag -%}
  {%- render 'joynure-baby-landing-enabled', product: product -%}
{%- endcapture -%}
{%- if enabled_flag == 'true' -%}
  {%- liquid
    assign is_mat = false
    if product.handle == 'portable-foldable-baby-changing-mat-waterproof-travel-changing-pad'
      assign is_mat = true
    endif
    assign included_asset = 'baby-nail-included.jpg'
    if is_mat
      assign included_asset = 'baby-mat-included.jpg'
      assign inc_heading = section.settings.heading_mat | default: section.settings.heading
      assign inc_lede = section.settings.lede_mat | default: 'One foldable mat. Ready for home and travel changes.'
      assign item_1 = section.settings.item_1_mat | default: '1 × Portable Foldable Baby Changing Mat'
      assign item_2 = section.settings.item_2_mat | default: 'Waterproof wipe-clean surface'
      assign item_3 = section.settings.item_3_mat | default: 'Clutch-fold design for diaper bags'
    else
      assign inc_heading = section.settings.heading
      assign inc_lede = section.settings.lede
      assign item_1 = section.settings.item_1
      assign item_2 = section.settings.item_2
      assign item_3 = section.settings.item_3
    endif
  -%}
  {{ 'joynure-hula-landing.css' | asset_url | stylesheet_tag }}
  <section class="joynure-hula-landing joynure-hula-landing__section joynure-hula-landing__section--blush" {{ section.shopify_attributes }}>
    <div class="joynure-hula-landing__inner joynure-hula-included__grid">
      <div>
        {% render 'joynure-hula-media',
          product: product,
          setting_image: section.settings.image,
          asset_file: included_asset,
          media_id: section.settings.media_id,
          alt: inc_heading,
          class: 'joynure-hula-landing__media joynure-hula-landing__media--contain',
          loading: 'lazy',
          sizes: '(min-width: 750px) 55vw, 100vw'
        %}
      </div>
      <div>
        <h2 class="joynure-hula-landing__title">{{ inc_heading | escape }}</h2>
        <p class="joynure-hula-landing__lede">{{ inc_lede | escape }}</p>
        <ul class="joynure-hula-included__list">
          <li>{{ item_1 | escape }}</li>
          <li>{{ item_2 | escape }}</li>
          <li>{{ item_3 | escape }}</li>
        </ul>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "JOYNURE Baby included",
  "tag": "section",
  "class": "joynure-hula-landing-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What's Included" },
    { "type": "text", "id": "heading_mat", "label": "Heading (mat)", "default": "What's Included" },
    { "type": "textarea", "id": "lede", "label": "Supporting copy", "default": "One quiet electric set. Ready for gentle nail care." },
    { "type": "textarea", "id": "lede_mat", "label": "Supporting copy (mat)", "default": "One foldable mat. Ready for home and travel changes." },
    { "type": "image_picker", "id": "image", "label": "Kit image" },
    { "type": "text", "id": "asset_file", "label": "Theme asset", "default": "baby-included.jpg" },
    { "type": "text", "id": "media_id", "label": "Fallback media ID" },
    { "type": "text", "id": "item_1", "label": "Item 1", "default": "1 × Electric Baby Nail Trimmer" },
    { "type": "text", "id": "item_2", "label": "Item 2", "default": "Soft age-stage pad set" },
    { "type": "text", "id": "item_3", "label": "Item 3", "default": "LED light for precise, gentle care" },
    { "type": "text", "id": "item_1_mat", "label": "Item 1 (mat)", "default": "1 × Portable Foldable Baby Changing Mat" },
    { "type": "text", "id": "item_2_mat", "label": "Item 2 (mat)", "default": "Waterproof wipe-clean surface" },
    { "type": "text", "id": "item_3_mat", "label": "Item 3 (mat)", "default": "Clutch-fold design for diaper bags" }
  ],
  "presets": [{ "name": "JOYNURE Baby included" }]
}
{% endschema %}
