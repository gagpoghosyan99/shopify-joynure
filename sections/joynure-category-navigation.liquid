{{ 'joynure-category-interactor.css' | asset_url | stylesheet_tag }}
<script src="{{ 'joynure-category-interactor.js' | asset_url }}" defer="defer"></script>

{% liquid
  assign first_block = section.blocks.first
  assign first_image = blank
  if first_block.settings.image != blank
    assign first_image = first_block.settings.image | image_url: width: 1200
  elsif first_block.settings.product.featured_image != blank
    assign first_image = first_block.settings.product.featured_image | image_url: width: 1200
  elsif first_block.settings.category == 'pet'
    assign first_image = 'joynure-category-pet.svg' | asset_url
  elsif first_block.settings.category == 'baby'
    assign first_image = 'joynure-category-baby.svg' | asset_url
  else
    assign first_image = 'joynure-category-active.svg' | asset_url
  endif
%}

<joynure-category-interactor
  class="joynure-category-interactor"
  style="--joynure-category-background: {{ section.settings.background }}; --joynure-category-text: {{ section.settings.text_color }}; --joynure-category-accent: {{ section.settings.accent_color }};"
  data-section-id="{{ section.id }}"
>
  <div class="joynure-category-interactor__menu">
    {% if section.settings.eyebrow != blank %}
      <p class="joynure-category-interactor__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}

    <nav aria-label="{{ section.settings.navigation_label | escape }}">
      <ul class="joynure-category-interactor__list" role="list">
        {% for block in section.blocks %}
          {% liquid
            assign category_image = blank
            if block.settings.image != blank
              assign category_image = block.settings.image | image_url: width: 1200
            elsif block.settings.product.featured_image != blank
              assign category_image = block.settings.product.featured_image | image_url: width: 1200
            elsif block.settings.category == 'pet'
              assign category_image = 'joynure-category-pet.svg' | asset_url
            elsif block.settings.category == 'baby'
              assign category_image = 'joynure-category-baby.svg' | asset_url
            else
              assign category_image = 'joynure-category-active.svg' | asset_url
            endif

            assign category_link = block.settings.link
            if block.settings.product != blank
              assign category_link = block.settings.product.url
            endif
          %}

          <li class="joynure-category-interactor__item" {{ block.shopify_attributes }}>
            <a
              class="joynure-category-interactor__trigger{% if forloop.first %} is-active{% endif %}"
              href="{{ category_link | default: routes.all_products_collection_url }}"
              data-joynure-category-trigger
              data-index="{{ forloop.index0 }}"
              data-image="{{ category_image | escape }}"
              data-clip="joynure-clip-{{ forloop.index0 }}-{{ section.id }}"
              aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
            >
              <span class="joynure-category-interactor__number" aria-hidden="true">{{ forloop.index | prepend: '0' }}</span>
              <span class="joynure-category-interactor__title">
                {% assign title_words = block.settings.heading | split: ' ' %}
                {% for word in title_words %}
                  {{ word | escape }}{% unless forloop.last %}<br>{% endunless %}
                {% endfor %}
              </span>
            </a>
          </li>
        {% endfor %}
      </ul>
    </nav>
  </div>

  <div class="joynure-category-interactor__visual" aria-hidden="true">
    <div class="joynure-category-interactor__glow"></div>
    <svg viewBox="0 0 500 500" role="presentation" focusable="false">
      <defs>
        <clipPath id="joynure-clip-0-{{ section.id }}" data-clip-index="0">
          <path class="path" d="M480.6,235H19.4c-6,0-10.8-4.9-10.8-10.8v-9.5c0-6,4.9-10.8,10.8-10.8h461.1c6,0,10.8,4.9,10.8,10.8v9.5C491.4,230.2,486.6,235,480.6,235z" />
          <path class="path" d="M483.1,362.4H16.9c-4.6,0-8.3-3.7-8.3-8.3v-1.8c0-4.6,3.7-8.3,8.3-8.3h466.1c4.6,0,8.3,3.7,8.3,8.3v1.8C491.4,358.7,487.7,362.4,483.1,362.4z" />
          <path class="path" d="M460.3,336.3H39.7c-17.2,0-31.1-13.9-31.1-31.1v-31.5c0-17.2,13.9-31.1,31.1-31.1h420.7c17.2,0,31.1,13.9,31.1,31.1v31.5C491.4,322.4,477.5,336.3,460.3,336.3z" />
          <path class="path" d="M459.2,196.2H40.8v-35c0-47.5,38.5-86,86-86h246.5c47.5,0,86,38.5,86,86V196.2z" />
          <path class="path" d="M441.9,424.9H58.1c-9.6,0-17.3-7.8-17.3-17.3v-37.4h418.5v37.4C459.2,417.1,451.5,424.9,441.9,424.9z" />
        </clipPath>

        <clipPath id="joynure-clip-1-{{ section.id }}" data-clip-index="1">
          <rect class="path" x="20" y="20" width="200" height="280" rx="12" />
          <rect class="path" x="20" y="320" width="200" height="160" rx="12" />
          <rect class="path" x="240" y="20" width="240" height="140" rx="12" />
          <rect class="path" x="240" y="180" width="110" height="160" rx="12" />
          <rect class="path" x="370" y="180" width="110" height="160" rx="12" />
          <rect class="path" x="240" y="360" width="240" height="120" rx="12" />
        </clipPath>

        <clipPath id="joynure-clip-2-{{ section.id }}" data-clip-index="2">
          {% for row in (0..2) %}
            {% for column in (0..2) %}
              <rect class="path" x="{{ column | times: 160 | plus: 20 }}" y="{{ row | times: 160 | plus: 20 }}" width="140" height="140" rx="4" />
            {% endfor %}
          {% endfor %}
        </clipPath>
      </defs>

      <g data-joynure-category-image-group clip-path="url(#joynure-clip-0-{{ section.id }})">
        <image
          data-joynure-category-image
          href="{{ first_image | escape }}"
          width="500"
          height="500"
          preserveAspectRatio="xMidYMid slice"
        />
      </g>
    </svg>
  </div>
</joynure-category-interactor>

{% schema %}
{
  "name": "JOYNURE category menu",
  "tag": "section",
  "class": "joynure-category-section",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Choose your kind of joy"
    },
    {
      "type": "text",
      "id": "navigation_label",
      "label": "Accessibility label",
      "default": "Shop by category"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#FFF8F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#24312E"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#FF7A68"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Hula Hoop"
        },
        {
          "type": "select",
          "id": "category",
          "label": "Fallback artwork",
          "options": [
            { "value": "active", "label": "Hula hoop" },
            { "value": "pet", "label": "Pet care" },
            { "value": "baby", "label": "Baby care" }
          ],
          "default": "active"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image",
          "info": "Overrides the product image."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link",
          "info": "Used when no product is selected."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "JOYNURE category menu",
      "category": "JOYNURE",
      "blocks": [
        { "type": "category", "settings": { "heading": "Hula Hoop", "category": "active" } },
        { "type": "category", "settings": { "heading": "Pet Care", "category": "pet" } },
        { "type": "category", "settings": { "heading": "Baby Care", "category": "baby" } }
      ]
    }
  ]
}
{% endschema %}
