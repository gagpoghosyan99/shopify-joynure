{%- capture enabled_flag -%}
  {%- render 'joynure-hula-landing-enabled', product: product -%}
{%- endcapture -%}
{%- if enabled_flag == 'true' -%}
  {{ 'joynure-hula-landing.css' | asset_url | stylesheet_tag }}
  <section class="joynure-hula-landing joynure-hula-benefits" {{ section.shopify_attributes }}>
    <div class="joynure-hula-landing__inner">
      <div class="joynure-hula-benefits__grid">
        <article class="joynure-hula-benefits__item">
          <svg class="joynure-hula-benefits__icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
            <circle cx="12" cy="12" r="8"/><path d="M8 12h8M12 8v8"/>
          </svg>
          <p class="joynure-hula-benefits__label">{{ section.settings.b1_label | escape }}</p>
          <p class="joynure-hula-benefits__text">{{ section.settings.b1_text | escape }}</p>
        </article>
        <article class="joynure-hula-benefits__item">
          <svg class="joynure-hula-benefits__icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
            <circle cx="12" cy="12" r="3"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3"/>
          </svg>
          <p class="joynure-hula-benefits__label">{{ section.settings.b2_label | escape }}</p>
          <p class="joynure-hula-benefits__text">{{ section.settings.b2_text | escape }}</p>
        </article>
        <article class="joynure-hula-benefits__item">
          <svg class="joynure-hula-benefits__icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M5 12c2-4 4-6 7-6s5 2 7 6c-2 4-4 6-7 6s-5-2-7-6Z"/>
          </svg>
          <p class="joynure-hula-benefits__label">{{ section.settings.b3_label | escape }}</p>
          <p class="joynure-hula-benefits__text">{{ section.settings.b3_text | escape }}</p>
        </article>
        <article class="joynure-hula-benefits__item">
          <svg class="joynure-hula-benefits__icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
            <rect x="4" y="7" width="16" height="12" rx="2"/><path d="M8 7V5h8v2"/>
          </svg>
          <p class="joynure-hula-benefits__label">{{ section.settings.b4_label | escape }}</p>
          <p class="joynure-hula-benefits__text">{{ section.settings.b4_text | escape }}</p>
        </article>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "JOYNURE Hula benefits",
  "tag": "section",
  "class": "joynure-hula-landing-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "b1_label", "label": "Benefit 1 label", "default": "Adjustable fit" },
    { "type": "text", "id": "b1_text", "label": "Benefit 1 text", "default": "Add or remove sections to personalize the fit." },
    { "type": "text", "id": "b2_label", "label": "Benefit 2 label", "default": "Weighted gravity ball" },
    { "type": "text", "id": "b2_text", "label": "Benefit 2 text", "default": "A rotating weighted system for more engaging home movement." },
    { "type": "text", "id": "b3_label", "label": "Benefit 3 label", "default": "Easy to use" },
    { "type": "text", "id": "b3_text", "label": "Benefit 3 text", "default": "Simple setup designed for everyday home fitness." },
    { "type": "text", "id": "b4_label", "label": "Benefit 4 label", "default": "Compact storage" },
    { "type": "text", "id": "b4_text", "label": "Benefit 4 text", "default": "Detachable construction for easier storage." }
  ],
  "presets": [{ "name": "JOYNURE Hula benefits" }]
}
{% endschema %}
