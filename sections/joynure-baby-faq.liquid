{%- capture enabled_flag -%}
  {%- render 'joynure-baby-landing-enabled', product: product -%}
{%- endcapture -%}
{%- if enabled_flag == 'true' -%}
  {%- liquid
    assign is_mat = false
    if product.handle == 'portable-foldable-baby-changing-mat-waterproof-travel-changing-pad'
      assign is_mat = true
    endif
  -%}
  {{ 'joynure-hula-landing.css' | asset_url | stylesheet_tag }}
  <section class="joynure-hula-landing joynure-hula-landing__section joynure-hula-landing__section--blush" {{ section.shopify_attributes }}>
    <div class="joynure-hula-landing__inner">
      <h2 class="joynure-hula-landing__title joynure-hula-landing__title--center">{{ section.settings.heading | escape }}</h2>
      <div class="joynure-hula-faq__list">
        {% for i in (1..8) %}
          {% liquid
            assign qk = 'q' | append: i
            assign ak = 'a' | append: i
            assign q = section.settings[qk]
            assign a = section.settings[ak]
            if is_mat
              case i
                when 1
                  assign q = 'How do I use the changing mat?'
                  assign a = 'Unfold the clutch into a flat padded surface, change baby, wipe the waterproof top clean, then fold and pack away.'
                when 2
                  assign q = 'Is it waterproof?'
                  assign a = 'Yes. The top surface is designed to wipe clean after messes without soaking through.'
                when 3
                  assign q = 'Does it fit in a diaper bag?'
                  assign a = 'Yes. It folds into a compact clutch for diaper bags, strollers, and car kits.'
                when 4
                  assign q = 'Can I use it on public surfaces?'
                  assign a = 'Yes — that is the point. Soft padding for floors, park tables, and restroom counters.'
                when 5
                  assign q = 'Which colors are available?'
                  assign a = 'Black, Black Grey, Colorful, White Black, White Grey, and Gray.'
                when 6
                  assign q = 'Is it reusable?'
                  assign a = 'Yes. Wipe clean and reuse instead of buying thin disposable pads.'
                when 7
                  assign q = 'How should I store it?'
                  assign a = 'Fold into the clutch and keep it in a diaper bag, car console, or nursery drawer.'
                when 8
                  assign q = 'What comes in the package?'
                  assign a = 'One portable foldable baby changing mat with waterproof wipe-clean surface.'
              endcase
            endif
          %}
          {% if q != blank %}
            <details class="joynure-hula-faq__item">
              <summary>{{ q | escape }}</summary>
              <p>{{ a | escape }}</p>
            </details>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "JOYNURE Baby FAQ",
  "tag": "section",
  "class": "joynure-hula-landing-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions?" },
    { "type": "text", "id": "q1", "label": "Q1", "default": "How do I use the nail trimmer?" },
    { "type": "textarea", "id": "a1", "label": "A1", "default": "Choose an age-stage pad, turn on the LED, and gently guide the soft rotating pad along the nail edge." },
    { "type": "text", "id": "q2", "label": "Q2", "default": "Is it safe for newborns?" },
    { "type": "textarea", "id": "a2", "label": "A2", "default": "Yes — use the softest pad for newborns and always supervise. Soft pads file instead of cutting with blades." },
    { "type": "text", "id": "q3", "label": "Q3", "default": "Why is there an LED light?" },
    { "type": "textarea", "id": "a3", "label": "A3", "default": "The light helps you see tiny nail edges clearly — especially helpful for toes at bedtime." },
    { "type": "text", "id": "q4", "label": "Q4", "default": "Do I need different pads as baby grows?" },
    { "type": "textarea", "id": "a4", "label": "A4", "default": "Yes. Swap pads to match age stages from newborn through toddler for the gentlest feel." },
    { "type": "text", "id": "q5", "label": "Q5", "default": "Which colors are available?" },
    { "type": "textarea", "id": "a5", "label": "A5", "default": "Blue and Pink." },
    { "type": "text", "id": "q6", "label": "Q6", "default": "Is it quieter than clippers?" },
    { "type": "textarea", "id": "a6", "label": "A6", "default": "The electric motor is designed for quiet everyday use so bedtime routines stay calmer." },
    { "type": "text", "id": "q7", "label": "Q7", "default": "How should I store it?" },
    { "type": "textarea", "id": "a7", "label": "A7", "default": "Keep the trimmer and pads together in a diaper bag, bathroom drawer, or nightstand." },
    { "type": "text", "id": "q8", "label": "Q8", "default": "What comes in the package?" },
    { "type": "textarea", "id": "a8", "label": "A8", "default": "One electric baby nail trimmer with a soft age-stage pad set and LED light assist." }
  ],
  "presets": [{ "name": "JOYNURE Baby FAQ" }]
}
{% endschema %}
