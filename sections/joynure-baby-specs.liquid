{%- capture enabled_flag -%}
  {%- render 'joynure-baby-landing-enabled', product: product -%}
{%- endcapture -%}
{%- if enabled_flag == 'true' -%}
  {%- liquid
    assign is_mat = false
    if product.handle == 'portable-foldable-baby-changing-mat-waterproof-travel-changing-pad'
      assign is_mat = true
    endif
    assign specs_asset = 'baby-nail-specs.jpg'
    if is_mat
      assign specs_asset = 'baby-mat-specs.jpg'
      assign specs_alt = 'JOYNURE Foldable Baby Changing Mat'
      assign v1 = 'Portable foldable changing mat'
      assign v2 = 'Waterproof wipe-clean surface'
      assign v3 = 'Folds to clutch size for travel'
      assign v4 = 'Padded comfort core'
      assign v5 = 'Home, car, park, restrooms'
      assign v6 = 'Black / Black Grey / Colorful / White Black / White Grey / Gray'
      assign v7 = '1 × foldable baby changing mat'
    else
      assign specs_alt = 'JOYNURE Electric Baby Nail Trimmer'
      assign v1 = section.settings.v1
      assign v2 = section.settings.v2
      assign v3 = section.settings.v3
      assign v4 = section.settings.v4
      assign v5 = section.settings.v5
      assign v6 = section.settings.v6
      assign v7 = section.settings.v7
    endif
  -%}
  {{ 'joynure-hula-landing.css' | asset_url | stylesheet_tag }}
  <section class="joynure-hula-landing joynure-hula-landing__section" {{ section.shopify_attributes }}>
    <div class="joynure-hula-landing__inner joynure-hula-specs__grid">
      <div>
        <h2 class="joynure-hula-landing__title">Product <span class="joynure-hula-landing__title-accent">Specifications</span></h2>
        <ul class="joynure-hula-specs__list">
          {% for i in (1..7) %}
            {% liquid
              assign lk = 'l' | append: i
              case i
                when 1
                  assign vv = v1
                when 2
                  assign vv = v2
                when 3
                  assign vv = v3
                when 4
                  assign vv = v4
                when 5
                  assign vv = v5
                when 6
                  assign vv = v6
                when 7
                  assign vv = v7
              endcase
            %}
            <li>
              <strong>{{ section.settings[lk] | escape }}</strong>
              <span>{{ vv | escape }}</span>
            </li>
          {% endfor %}
        </ul>
      </div>
      <div class="joynure-hula-specs__media">
        {% render 'joynure-hula-media',
          product: product,
          setting_image: section.settings.image,
          asset_file: specs_asset,
          media_id: section.settings.media_id,
          alt: specs_alt,
          class: 'joynure-hula-landing__media joynure-hula-landing__media--contain',
          loading: 'lazy',
          sizes: '(min-width: 750px) 40vw, 100vw'
        %}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "JOYNURE Baby specs",
  "tag": "section",
  "class": "joynure-hula-landing-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Specs image" },
    { "type": "text", "id": "asset_file", "label": "Theme asset", "default": "baby-specs.jpg" },
    { "type": "text", "id": "media_id", "label": "Fallback media ID" },
    { "type": "text", "id": "l1", "label": "Label 1", "default": "Type" },
    { "type": "text", "id": "v1", "label": "Value 1", "default": "Electric baby nail trimmer set" },
    { "type": "text", "id": "l2", "label": "Label 2", "default": "Care method" },
    { "type": "text", "id": "v2", "label": "Value 2", "default": "Soft rotating pads + LED assist" },
    { "type": "text", "id": "l3", "label": "Label 3", "default": "Age stages" },
    { "type": "text", "id": "v3", "label": "Value 3", "default": "Newborn through toddler pad set" },
    { "type": "text", "id": "l4", "label": "Label 4", "default": "Power" },
    { "type": "text", "id": "v4", "label": "Value 4", "default": "Quiet rechargeable / battery electric" },
    { "type": "text", "id": "l5", "label": "Label 5", "default": "Best for" },
    { "type": "text", "id": "v5", "label": "Value 5", "default": "Fingers, toes, bedtime nail care" },
    { "type": "text", "id": "l6", "label": "Label 6", "default": "Colors" },
    { "type": "text", "id": "v6", "label": "Value 6", "default": "Blue / Pink" },
    { "type": "text", "id": "l7", "label": "Label 7", "default": "Package" },
    { "type": "text", "id": "v7", "label": "Value 7", "default": "1 × electric nail trimmer + soft pads" }
  ],
  "presets": [{ "name": "JOYNURE Baby specs" }]
}
{% endschema %}
