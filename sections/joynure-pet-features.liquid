{%- capture enabled_flag -%}
  {%- render 'joynure-pet-landing-enabled', product: product -%}
{%- endcapture -%}
{%- if enabled_flag == 'true' -%}
  {{ 'joynure-hula-landing.css' | asset_url | stylesheet_tag }}
  <section class="joynure-hula-landing joynure-hula-landing__section" {{ section.shopify_attributes }}>
    <div class="joynure-hula-landing__inner">
      <h2 class="joynure-hula-landing__title joynure-hula-landing__title--center">{{ section.settings.heading | escape }}</h2>
      <p class="joynure-hula-landing__lede joynure-hula-landing__lede--center">{{ section.settings.lede | escape }}</p>
      <div class="joynure-hula-features__grid">
        {% for i in (1..6) %}
          {% liquid
            assign tk = 'c' | append: i | append: '_title'
            assign xk = 'c' | append: i | append: '_text'
          %}
          <article class="joynure-hula-features__card">
            <h3>{{ section.settings[tk] | escape }}</h3>
            <p>{{ section.settings[xk] | escape }}</p>
          </article>
        {% endfor %}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "JOYNURE Pet features",
  "tag": "section",
  "class": "joynure-hula-landing-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built for Everyday Pet Homes" },
    { "type": "textarea", "id": "lede", "label": "Supporting copy", "default": "Practical details that make reusable cleanup feel simple and reliable." },
    { "type": "text", "id": "c1_title", "label": "Card 1 title", "default": "Reusable by Design" },
    { "type": "textarea", "id": "c1_text", "label": "Card 1 text", "default": "No adhesive sheets or replacement rolls required." },
    { "type": "text", "id": "c2_title", "label": "Card 2 title", "default": "Self-Cleaning Chamber" },
    { "type": "textarea", "id": "c2_text", "label": "Card 2 text", "default": "Twist to clear the brush surface into the built-in chamber." },
    { "type": "text", "id": "c3_title", "label": "Card 3 title", "default": "Fabric-Friendly" },
    { "type": "textarea", "id": "c3_text", "label": "Card 3 text", "default": "Designed for clothing, upholstery, and similar fabric surfaces." },
    { "type": "text", "id": "c4_title", "label": "Card 4 title", "default": "Travel-Ready Size" },
    { "type": "textarea", "id": "c4_text", "label": "Card 4 text", "default": "Compact enough for a drawer, bag, or glove box." },
    { "type": "text", "id": "c5_title", "label": "Card 5 title", "default": "Four Colors" },
    { "type": "textarea", "id": "c5_text", "label": "Card 5 text", "default": "Blue, Green, Pink, and White." },
    { "type": "text", "id": "c6_title", "label": "Card 6 title", "default": "No Batteries Needed" },
    { "type": "textarea", "id": "c6_text", "label": "Card 6 text", "default": "Simple mechanical design — ready whenever hair shows up." }
  ],
  "presets": [{ "name": "JOYNURE Pet features" }]
}
{% endschema %}
