{%- capture enabled_flag -%}
  {%- render 'joynure-baby-landing-enabled', product: product -%}
{%- endcapture -%}
{%- if enabled_flag == 'true' -%}
  {%- liquid
    assign is_mat = false
    if product.handle == 'portable-foldable-baby-changing-mat-waterproof-travel-changing-pad'
      assign is_mat = true
    endif
    assign mech_asset = section.settings.asset_file | default: 'baby-mechanism-hero.jpg'
    if is_mat
      if section.settings.asset_file == blank or section.settings.asset_file == 'baby-mechanism-hero.jpg'
        assign mech_asset = 'baby-mat-mechanism-hero.jpg'
      endif
      assign mech_eyebrow = section.settings.eyebrow_mat | default: 'Travel-ready build'
      assign mech_heading = section.settings.heading_mat | default: 'Built to Fold — Then Wipe Clean'
      assign mech_lede = section.settings.lede_mat | default: 'A waterproof padded surface with a clutch fold for diaper bags, cars, and day trips.'
      assign i1_title = 'Waterproof top layer'
      assign i1_text = 'Wipe spills and messes clean without soaking through.'
      assign i2_title = 'Soft padded core'
      assign i2_text = 'Cushioned comfort on floors, benches, and park tables.'
      assign i3_title = 'Clutch-fold design'
      assign i3_text = 'Folds compact for strollers, totes, and travel kits.'
      assign i4_title = 'Reusable every day'
      assign i4_text = 'Skip thin disposable pads that tear and slip.'
    else
      assign mech_eyebrow = section.settings.eyebrow
      assign mech_heading = section.settings.heading
      assign mech_lede = section.settings.lede
      assign i1_title = section.settings.i1_title
      assign i1_text = section.settings.i1_text
      assign i2_title = section.settings.i2_title
      assign i2_text = section.settings.i2_text
      assign i3_title = section.settings.i3_title
      assign i3_text = section.settings.i3_text
      assign i4_title = section.settings.i4_title
      assign i4_text = section.settings.i4_text
    endif
  -%}
  {{ 'joynure-hula-landing.css' | asset_url | stylesheet_tag }}
  <section class="joynure-hula-landing joynure-hula-landing__section" {{ section.shopify_attributes }}>
    <div class="joynure-hula-landing__inner">
      <div class="joynure-hula-mechanism__intro">
        <p class="joynure-hula-landing__eyebrow">{{ mech_eyebrow | escape }}</p>
        <h2 class="joynure-hula-landing__title joynure-hula-landing__title--center">{{ mech_heading | escape }}</h2>
        <p class="joynure-hula-landing__lede joynure-hula-landing__lede--center">{{ mech_lede | escape }}</p>
      </div>
      <div class="joynure-hula-mechanism__grid">
        <div class="joynure-hula-card-3d joynure-hula-mechanism__visual">
          <div class="joynure-hula-card-3d__media">
            {% render 'joynure-hula-media',
              product: product,
              setting_image: section.settings.image,
              asset_file: mech_asset,
              media_id: section.settings.media_id,
              alt: mech_heading,
              class: 'joynure-hula-landing__media',
              loading: 'lazy',
              sizes: '(min-width: 990px) 50vw, 100vw'
            %}
          </div>
        </div>
        <div class="joynure-hula-mechanism__cards">
          {% for i in (1..4) %}
            {% liquid
              case i
                when 1
                  assign pt = i1_title
                  assign px = i1_text
                when 2
                  assign pt = i2_title
                  assign px = i2_text
                when 3
                  assign pt = i3_title
                  assign px = i3_text
                when 4
                  assign pt = i4_title
                  assign px = i4_text
              endcase
            %}
            <article class="joynure-hula-card-3d joynure-hula-mechanism__card">
              <div class="joynure-hula-card-3d__body">
                <h3>{{ pt | escape }}</h3>
                <p>{{ px | escape }}</p>
              </div>
            </article>
          {% endfor %}
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "JOYNURE Baby mechanism",
  "tag": "section",
  "class": "joynure-hula-landing-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Electric nail set" },
    { "type": "text", "id": "eyebrow_mat", "label": "Eyebrow (mat)", "default": "Travel-ready build" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built to Trim — Softly & Quietly" },
    { "type": "text", "id": "heading_mat", "label": "Heading (mat)", "default": "Built to Fold — Then Wipe Clean" },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Supporting copy",
      "default": "A quiet motor, soft rotating pads, and LED light for safer nail care on tiny fingers and toes."
    },
    {
      "type": "textarea",
      "id": "lede_mat",
      "label": "Supporting copy (mat)",
      "default": "A waterproof padded surface with a clutch fold for diaper bags, cars, and day trips."
    },
    { "type": "image_picker", "id": "image", "label": "Detail image" },
    { "type": "text", "id": "asset_file", "label": "Theme asset", "default": "baby-mechanism-hero.jpg" },
    { "type": "text", "id": "media_id", "label": "Fallback media ID" },
    { "type": "text", "id": "i1_title", "label": "Point 1 title", "default": "Soft rotating pads" },
    { "type": "textarea", "id": "i1_text", "label": "Point 1 text", "default": "Files nails gently instead of cutting with sharp clippers." },
    { "type": "text", "id": "i2_title", "label": "Point 2 title", "default": "Quiet electric motor" },
    { "type": "textarea", "id": "i2_text", "label": "Point 2 text", "default": "Low-noise trimming that helps keep bedtime calm." },
    { "type": "text", "id": "i3_title", "label": "Point 3 title", "default": "LED light assist" },
    { "type": "textarea", "id": "i3_text", "label": "Point 3 text", "default": "See nail edges clearly — especially helpful for tiny toes." },
    { "type": "text", "id": "i4_title", "label": "Point 4 title", "default": "Age-stage pad set" },
    { "type": "textarea", "id": "i4_text", "label": "Point 4 text", "default": "Swap pads as nails grow from newborn through toddler." }
  ],
  "presets": [{ "name": "JOYNURE Baby mechanism" }]
}
{% endschema %}
