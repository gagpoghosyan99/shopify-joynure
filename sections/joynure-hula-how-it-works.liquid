{%- capture enabled_flag -%}
  {%- render 'joynure-hula-landing-enabled', product: product -%}
{%- endcapture -%}
{%- if enabled_flag == 'true' -%}
  {{ 'joynure-hula-landing.css' | asset_url | stylesheet_tag }}
  <section class="joynure-hula-landing joynure-hula-landing__section joynure-hula-landing__section--blush" {{ section.shopify_attributes }}>
    <div class="joynure-hula-landing__inner">
      <h2 class="joynure-hula-landing__title joynure-hula-landing__title--center">{{ section.settings.heading | escape }}</h2>
      <p class="joynure-hula-landing__lede joynure-hula-landing__lede--center">{{ section.settings.lede | escape }}</p>
      <div class="joynure-hula-how__hero">
        {% render 'joynure-hula-media',
          product: product,
          setting_image: section.settings.image,
          media_id: section.settings.media_id,
          alt: section.settings.heading,
          class: 'joynure-hula-landing__media',
          loading: 'lazy',
          sizes: '100vw'
        %}
      </div>
      <div class="joynure-hula-how__steps">
        <article class="joynure-hula-how__step">
          <p class="joynure-hula-how__num">01</p>
          <h3>{{ section.settings.s1_title | escape }}</h3>
          <p>{{ section.settings.s1_text | escape }}</p>
        </article>
        <article class="joynure-hula-how__step">
          <p class="joynure-hula-how__num">02</p>
          <h3>{{ section.settings.s2_title | escape }}</h3>
          <p>{{ section.settings.s2_text | escape }}</p>
        </article>
        <article class="joynure-hula-how__step">
          <p class="joynure-hula-how__num">03</p>
          <h3>{{ section.settings.s3_title | escape }}</h3>
          <p>{{ section.settings.s3_text | escape }}</p>
        </article>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "JOYNURE Hula how it works",
  "tag": "section",
  "class": "joynure-hula-landing-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "See How It Works" },
    { "type": "textarea", "id": "lede", "label": "Supporting copy", "default": "A simple adjustable design that turns everyday movement into a more engaging home workout." },
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "media_id", "label": "Fallback media ID", "default": "45010744803601" },
    { "type": "text", "id": "s1_title", "label": "Step 1 title", "default": "Adjust Your Fit" },
    { "type": "textarea", "id": "s1_text", "label": "Step 1 text", "default": "Add or remove sections for a comfortable waist fit." },
    { "type": "text", "id": "s2_title", "label": "Step 2 title", "default": "Attach the Weight" },
    { "type": "textarea", "id": "s2_text", "label": "Step 2 text", "default": "Secure the cord and weighted gravity ball to the track." },
    { "type": "text", "id": "s3_title", "label": "Step 3 title", "default": "Start Moving" },
    { "type": "textarea", "id": "s3_text", "label": "Step 3 text", "default": "Use steady waist movement to guide the rotating ball around the track." }
  ],
  "presets": [{ "name": "JOYNURE Hula how it works" }]
}
{% endschema %}
