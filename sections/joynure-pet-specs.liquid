{%- capture enabled_flag -%}
  {%- render 'joynure-pet-landing-enabled', product: product -%}
{%- endcapture -%}
{%- if enabled_flag == 'true' -%}
  {{ 'joynure-hula-landing.css' | asset_url | stylesheet_tag }}
  <section class="joynure-hula-landing joynure-hula-landing__section" {{ section.shopify_attributes }}>
    <div class="joynure-hula-landing__inner joynure-hula-specs__grid">
      <div>
        <h2 class="joynure-hula-landing__title">Product <span class="joynure-hula-landing__title-accent">Specifications</span></h2>
        <ul class="joynure-hula-specs__list">
          {% for i in (1..7) %}
            {% liquid
              assign lk = 'l' | append: i
              assign vk = 'v' | append: i
            %}
            <li>
              <strong>{{ section.settings[lk] | escape }}</strong>
              <span>{{ section.settings[vk] | escape }}</span>
            </li>
          {% endfor %}
        </ul>
      </div>
      <div class="joynure-hula-specs__media">
        {% render 'joynure-hula-media',
          product: product,
          setting_image: section.settings.image,
          asset_file: section.settings.asset_file | default: 'hula-specs.jpg',
          media_id: section.settings.media_id,
          alt: 'JOYNURE 2-in-1 Pet Hair Remover',
          class: 'joynure-hula-landing__media joynure-hula-landing__media--contain',
          loading: 'lazy',
          sizes: '(min-width: 750px) 40vw, 100vw'
        %}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "JOYNURE Pet specs",
  "tag": "section",
  "class": "joynure-hula-landing-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Specs image" },
    { "type": "text", "id": "asset_file", "label": "Theme asset", "default": "pet-specs.jpg" },
    { "type": "text", "id": "media_id", "label": "Fallback media ID", "default": "45015235625233" },
    { "type": "text", "id": "l1", "label": "Label 1", "default": "Type" },
    { "type": "text", "id": "v1", "label": "Value 1", "default": "Reusable pet hair remover" },
    { "type": "text", "id": "l2", "label": "Label 2", "default": "Cleaning method" },
    { "type": "text", "id": "v2", "label": "Value 2", "default": "Electrostatic adsorption + chamber" },
    { "type": "text", "id": "l3", "label": "Label 3", "default": "Size" },
    { "type": "text", "id": "v3", "label": "Value 3", "default": "18.3 × 4.3 × 4.3 cm / 7.2 × 1.7 × 1.7 in" },
    { "type": "text", "id": "l4", "label": "Label 4", "default": "Power" },
    { "type": "text", "id": "v4", "label": "Value 4", "default": "No batteries required" },
    { "type": "text", "id": "l5", "label": "Label 5", "default": "Best for" },
    { "type": "text", "id": "v5", "label": "Value 5", "default": "Sofas, clothing, bedding, car seats" },
    { "type": "text", "id": "l6", "label": "Label 6", "default": "Colors" },
    { "type": "text", "id": "v6", "label": "Value 6", "default": "Blue / Green / Pink / White" },
    { "type": "text", "id": "l7", "label": "Label 7", "default": "Package" },
    { "type": "text", "id": "v7", "label": "Value 7", "default": "1 × reusable pet hair remover" }
  ],
  "presets": [{ "name": "JOYNURE Pet specs" }]
}
{% endschema %}
