{%- capture enabled_flag -%}
  {%- render 'joynure-hula-landing-enabled', product: product -%}
{%- endcapture -%}
{%- if enabled_flag == 'true' -%}
  {{ 'joynure-hula-landing.css' | asset_url | stylesheet_tag }}
  <section class="joynure-hula-landing joynure-hula-landing__section" {{ section.shopify_attributes }}>
    <div class="joynure-hula-landing__inner joynure-hula-mechanism__grid">
      <div>
        {% render 'joynure-hula-media',
          product: product,
          setting_image: section.settings.image,
          media_id: section.settings.media_id,
          alt: section.settings.heading,
          class: 'joynure-hula-landing__media joynure-hula-landing__media--contain',
          loading: 'lazy',
          sizes: '(min-width: 990px) 50vw, 100vw'
        %}
      </div>
      <div>
        <p class="joynure-hula-landing__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        <h2 class="joynure-hula-landing__title">{{ section.settings.heading | escape }}</h2>
        <ul class="joynure-hula-mechanism__list">
          <li>
            <strong>{{ section.settings.i1_title | escape }}</strong>
            <span>{{ section.settings.i1_text | escape }}</span>
          </li>
          <li>
            <strong>{{ section.settings.i2_title | escape }}</strong>
            <span>{{ section.settings.i2_text | escape }}</span>
          </li>
          <li>
            <strong>{{ section.settings.i3_title | escape }}</strong>
            <span>{{ section.settings.i3_text | escape }}</span>
          </li>
          <li>
            <strong>{{ section.settings.i4_title | escape }}</strong>
            <span>{{ section.settings.i4_text | escape }}</span>
          </li>
        </ul>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "JOYNURE Hula mechanism",
  "tag": "section",
  "class": "joynure-hula-landing-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Product design" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Designed to Move With You" },
    { "type": "image_picker", "id": "image", "label": "Detail image" },
    { "type": "text", "id": "media_id", "label": "Fallback media ID", "default": "45010788942097" },
    { "type": "text", "id": "i1_title", "label": "Point 1 title", "default": "Adjustable detachable sections" },
    { "type": "textarea", "id": "i1_text", "label": "Point 1 text", "default": "24 interlocking sections let you refine the hoop size for a comfortable waist fit." },
    { "type": "text", "id": "i2_title", "label": "Point 2 title", "default": "Smooth internal track" },
    { "type": "textarea", "id": "i2_text", "label": "Point 2 text", "default": "The outer track guides the sliding attachment as you move." },
    { "type": "text", "id": "i3_title", "label": "Point 3 title", "default": "Adjustable cord" },
    { "type": "textarea", "id": "i3_text", "label": "Point 3 text", "default": "Change the cord length to suit your comfort and available space." },
    { "type": "text", "id": "i4_title", "label": "Point 4 title", "default": "Weighted gravity ball" },
    { "type": "textarea", "id": "i4_text", "label": "Point 4 text", "default": "The color-matched ball travels around the track with steady waist movement." }
  ],
  "presets": [{ "name": "JOYNURE Hula mechanism" }]
}
{% endschema %}
