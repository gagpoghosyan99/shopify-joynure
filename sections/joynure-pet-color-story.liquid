{%- capture enabled_flag -%}
  {%- render 'joynure-pet-landing-enabled', product: product -%}
{%- endcapture -%}
{%- if enabled_flag == 'true' -%}
  {{ 'joynure-hula-landing.css' | asset_url | stylesheet_tag }}
  <section class="joynure-hula-landing joynure-hula-landing__section" {{ section.shopify_attributes }}>
    <div class="joynure-hula-landing__inner">
      <h2 class="joynure-hula-landing__title joynure-hula-landing__title--center">
        <span class="joynure-hula-landing__title-accent">Find</span> Your Color
      </h2>
      <p class="joynure-hula-landing__lede joynure-hula-landing__lede--center">{{ section.settings.lede | escape }}</p>
      <div class="joynure-hula-colors__banners joynure-pet-colors__banners">
        {% for color in (1..4) %}
          {% liquid
            case color
              when 1
                assign name = section.settings.blue_title
                assign text = section.settings.blue_text
                assign img = section.settings.blue_image
                assign mid = section.settings.blue_media_id
                assign asset = section.settings.blue_asset_file | default: 'pet-color-blue.jpg'
                assign tone = 'blue'
              when 2
                assign name = section.settings.green_title
                assign text = section.settings.green_text
                assign img = section.settings.green_image
                assign mid = section.settings.green_media_id
                assign asset = section.settings.green_asset_file | default: 'pet-color-green.jpg'
                assign tone = 'green'
              when 3
                assign name = section.settings.pink_title
                assign text = section.settings.pink_text
                assign img = section.settings.pink_image
                assign mid = section.settings.pink_media_id
                assign asset = section.settings.pink_asset_file | default: 'pet-color-pink.jpg'
                assign tone = 'pink'
              when 4
                assign name = section.settings.white_title
                assign text = section.settings.white_text
                assign img = section.settings.white_image
                assign mid = section.settings.white_media_id
                assign asset = section.settings.white_asset_file | default: 'pet-color-white.jpg'
                assign tone = 'white'
            endcase
          %}
          <article class="joynure-hula-colors__banner joynure-hula-colors__banner--{{ tone }} joynure-pet-colors__banner">
            <div class="joynure-hula-colors__banner-media">
              {% render 'joynure-hula-media',
                product: product,
                setting_image: img,
                asset_file: asset,
                media_id: mid,
                alt: name,
                class: 'joynure-hula-landing__media',
                loading: 'lazy',
                sizes: '100vw'
              %}
            </div>
            <div class="joynure-hula-colors__banner-meta">
              <span class="joynure-hula-colors__badge">{{ name | escape }}</span>
              <h3>{{ name | escape }}</h3>
              <p>{{ text | escape }}</p>
            </div>
          </article>
        {% endfor %}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "JOYNURE Pet color story",
  "tag": "section",
  "class": "joynure-hula-landing-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "textarea", "id": "lede", "label": "Supporting copy", "default": "Four finishes. One reusable pet-hair cleanup tool." },
    { "type": "image_picker", "id": "blue_image", "label": "Blue image" },
    { "type": "text", "id": "blue_asset_file", "label": "Blue theme asset", "default": "pet-color-blue.jpg" },
    { "type": "text", "id": "blue_media_id", "label": "Blue media ID", "default": "45015236018449" },
    { "type": "text", "id": "blue_title", "label": "Blue title", "default": "Blue" },
    { "type": "textarea", "id": "blue_text", "label": "Blue text", "default": "A calm everyday finish that blends into bright living spaces." },
    { "type": "image_picker", "id": "green_image", "label": "Green image" },
    { "type": "text", "id": "green_asset_file", "label": "Green theme asset", "default": "pet-color-green.jpg" },
    { "type": "text", "id": "green_media_id", "label": "Green media ID", "default": "45015236083985" },
    { "type": "text", "id": "green_title", "label": "Green title", "default": "Green" },
    { "type": "textarea", "id": "green_text", "label": "Green text", "default": "A soft mint look for entryways, bathrooms, and daily cleanup moments." },
    { "type": "image_picker", "id": "pink_image", "label": "Pink image" },
    { "type": "text", "id": "pink_asset_file", "label": "Pink theme asset", "default": "pet-color-pink.jpg" },
    { "type": "text", "id": "pink_media_id", "label": "Pink media ID", "default": "45015235952913" },
    { "type": "text", "id": "pink_title", "label": "Pink title", "default": "Pink" },
    { "type": "textarea", "id": "pink_text", "label": "Pink text", "default": "A warm blush finish for bedrooms, closets, and soft-home corners." },
    { "type": "image_picker", "id": "white_image", "label": "White image" },
    { "type": "text", "id": "white_asset_file", "label": "White theme asset", "default": "pet-color-white.jpg" },
    { "type": "text", "id": "white_media_id", "label": "White media ID", "default": "45015236116753" },
    { "type": "text", "id": "white_title", "label": "White title", "default": "White" },
    { "type": "textarea", "id": "white_text", "label": "White text", "default": "A clean minimal finish that disappears into modern home spaces." }
  ],
  "presets": [{ "name": "JOYNURE Pet color story" }]
}
{% endschema %}
