{%- capture enabled_flag -%}
  {%- render 'joynure-pet-landing-enabled', product: product -%}
{%- endcapture -%}
{%- if enabled_flag == 'true' -%}
  {{ 'joynure-hula-landing.css' | asset_url | stylesheet_tag }}
  <section class="joynure-hula-landing joynure-hula-landing__section joynure-hula-landing__section--blush" {{ section.shopify_attributes }}>
    <div class="joynure-hula-landing__inner">
      <h2 class="joynure-hula-landing__title joynure-hula-landing__title--center">{{ section.settings.heading | escape }}</h2>
      <div class="joynure-hula-faq__list">
        {% for i in (1..8) %}
          {% liquid
            assign qk = 'q' | append: i
            assign ak = 'a' | append: i
            assign q = section.settings[qk]
            assign a = section.settings[ak]
          %}
          {% if q != blank %}
            <details class="joynure-hula-faq__item">
              <summary>{{ q | escape }}</summary>
              <p>{{ a | escape }}</p>
            </details>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "JOYNURE Pet FAQ",
  "tag": "section",
  "class": "joynure-hula-landing-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions?" },
    { "type": "text", "id": "q1", "label": "Q1", "default": "How do I use it?" },
    { "type": "textarea", "id": "a1", "label": "A1", "default": "Swipe the brush across fabric, twist the handle to move debris into the chamber, then empty and reuse." },
    { "type": "text", "id": "q2", "label": "Q2", "default": "What surfaces can I use it on?" },
    { "type": "textarea", "id": "a2", "label": "A2", "default": "Sofas, chairs, clothing, coats, bedding, and similar fabric surfaces. Also handy for car seats." },
    { "type": "text", "id": "q3", "label": "Q3", "default": "How does the self-cleaning work?" },
    { "type": "textarea", "id": "a3", "label": "A3", "default": "Twist the handle left and right to transfer collected hair from the brush surface into the chamber." },
    { "type": "text", "id": "q4", "label": "Q4", "default": "Do I need replacement sheets?" },
    { "type": "textarea", "id": "a4", "label": "A4", "default": "No. It is reusable — empty the chamber instead of buying adhesive sheets." },
    { "type": "text", "id": "q5", "label": "Q5", "default": "Which colors are available?" },
    { "type": "textarea", "id": "a5", "label": "A5", "default": "Blue, Green, Pink, and White." },
    { "type": "text", "id": "q6", "label": "Q6", "default": "Is it fabric-safe?" },
    { "type": "textarea", "id": "a6", "label": "A6", "default": "It is designed for everyday fabric cleanup. Spot-test delicate materials if you are unsure." },
    { "type": "text", "id": "q7", "label": "Q7", "default": "How should I store it?" },
    { "type": "textarea", "id": "a7", "label": "A7", "default": "Store upright in a drawer, bathroom cabinet, entryway basket, or keep one in the car." },
    { "type": "text", "id": "q8", "label": "Q8", "default": "What comes in the package?" },
    { "type": "textarea", "id": "a8", "label": "A8", "default": "One 2-in-1 reusable pet hair remover with built-in collection chamber." }
  ],
  "presets": [{ "name": "JOYNURE Pet FAQ" }]
}
{% endschema %}
