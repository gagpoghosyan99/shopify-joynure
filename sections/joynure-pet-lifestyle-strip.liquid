{%- capture enabled_flag -%}
  {%- render 'joynure-pet-landing-enabled', product: product -%}
{%- endcapture -%}
{%- if enabled_flag == 'true' -%}
  {{ 'joynure-hula-landing.css' | asset_url | stylesheet_tag }}
  <section class="joynure-hula-landing joynure-hula-landing__section" {{ section.shopify_attributes }}>
    <div class="joynure-hula-landing__inner">
      <h2 class="joynure-hula-landing__title joynure-hula-landing__title--center">
        <span class="joynure-hula-landing__title-accent">{{ section.settings.eyebrow | escape }}</span>
      </h2>
      {% if section.settings.lede != blank %}
        <p class="joynure-hula-landing__lede joynure-hula-landing__lede--center">{{ section.settings.lede | escape }}</p>
      {% endif %}
      <div class="joynure-hula-strip__track joynure-hula-strip__track--3d joynure-pet-strip__track">
        {% for i in (1..7) %}
          {% liquid
            assign img_key = 'image_' | append: i
            assign cap_key = 'caption_' | append: i
            assign mid_key = 'media_id_' | append: i
            assign asset_key = 'asset_' | append: i
            assign img = section.settings[img_key]
            assign caption = section.settings[cap_key]
            assign mid = section.settings[mid_key]
            assign asset = section.settings[asset_key]
          %}
          {% if asset != blank or img != blank or mid != blank %}
            <figure class="joynure-hula-card-3d joynure-hula-strip__card">
              <div class="joynure-hula-card-3d__media">
                {% render 'joynure-hula-media',
                  product: product,
                  setting_image: img,
                  asset_file: asset,
                  media_id: mid,
                  alt: caption,
                  class: 'joynure-hula-landing__media',
                  loading: 'lazy',
                  sizes: '(min-width: 750px) 22vw, 70vw'
                %}
              </div>
              {% if caption != blank %}
                <figcaption class="joynure-hula-card-3d__body joynure-hula-strip__caption">{{ caption | escape }}</figcaption>
              {% endif %}
            </figure>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "JOYNURE Pet lifestyle",
  "tag": "section",
  "class": "joynure-hula-landing-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Heading", "default": "Real cleanup, every day" },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Supporting copy",
      "default": "Usable moments across sofas, coats, bedding, car seats, and everyday fabrics."
    },
    { "type": "image_picker", "id": "image_1", "label": "Image 1" },
    { "type": "text", "id": "asset_1", "label": "Theme asset 1", "default": "pet-life-1.jpg" },
    { "type": "text", "id": "media_id_1", "label": "Fallback media ID 1" },
    { "type": "text", "id": "caption_1", "label": "Caption 1", "default": "Coats before you head out" },
    { "type": "image_picker", "id": "image_2", "label": "Image 2" },
    { "type": "text", "id": "asset_2", "label": "Theme asset 2", "default": "pet-life-2.jpg" },
    { "type": "text", "id": "media_id_2", "label": "Fallback media ID 2" },
    { "type": "text", "id": "caption_2", "label": "Caption 2", "default": "Sofa cleanup in seconds" },
    { "type": "image_picker", "id": "image_3", "label": "Image 3" },
    { "type": "text", "id": "asset_3", "label": "Theme asset 3", "default": "pet-life-3.jpg" },
    { "type": "text", "id": "media_id_3", "label": "Fallback media ID 3" },
    { "type": "text", "id": "caption_3", "label": "Caption 3", "default": "Bedroom-ready finish" },
    { "type": "image_picker", "id": "image_4", "label": "Image 4" },
    { "type": "text", "id": "asset_4", "label": "Theme asset 4", "default": "pet-life-4.jpg" },
    { "type": "text", "id": "media_id_4", "label": "Fallback media ID 4" },
    { "type": "text", "id": "caption_4", "label": "Caption 4", "default": "Car seats stay fresher" },
    { "type": "image_picker", "id": "image_5", "label": "Image 5" },
    { "type": "text", "id": "asset_5", "label": "Theme asset 5", "default": "pet-life-5.jpg" },
    { "type": "text", "id": "media_id_5", "label": "Fallback media ID 5" },
    { "type": "text", "id": "caption_5", "label": "Caption 5", "default": "Everyday clothing rescue" },
    { "type": "image_picker", "id": "image_6", "label": "Image 6" },
    { "type": "text", "id": "asset_6", "label": "Theme asset 6", "default": "pet-life-6.jpg" },
    { "type": "text", "id": "media_id_6", "label": "Fallback media ID 6" },
    { "type": "text", "id": "caption_6", "label": "Caption 6", "default": "Made for pet homes" },
    { "type": "image_picker", "id": "image_7", "label": "Image 7" },
    { "type": "text", "id": "asset_7", "label": "Theme asset 7", "default": "pet-life-7.jpg" },
    { "type": "text", "id": "media_id_7", "label": "Fallback media ID 7" },
    { "type": "text", "id": "caption_7", "label": "Caption 7", "default": "Keep one where you need it" }
  ],
  "presets": [{ "name": "JOYNURE Pet lifestyle strip" }]
}
{% endschema %}
