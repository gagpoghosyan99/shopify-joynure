{%- capture enabled_flag -%}
  {%- render 'joynure-hula-landing-enabled', product: product -%}
{%- endcapture -%}
{%- if enabled_flag == 'true' -%}
  {{ 'joynure-hula-landing.css' | asset_url | stylesheet_tag }}
  <section class="joynure-hula-landing joynure-hula-landing__section joynure-hula-landing__section--wash" {{ section.shopify_attributes }}>
    <div class="joynure-hula-landing__inner">
      <h2 class="joynure-hula-landing__title joynure-hula-landing__title--center">{{ section.settings.heading | escape }}</h2>
      <p class="joynure-hula-landing__lede joynure-hula-landing__lede--center">{{ section.settings.lede | escape }}</p>
      <div class="joynure-hula-steps__grid joynure-hula-steps__grid--3d">
        {% for i in (1..4) %}
          {% liquid
            assign tkey = 't' | append: i | append: '_title'
            assign xkey = 't' | append: i | append: '_text'
            assign ikey = 'image_' | append: i
            assign mkey = 'media_id_' | append: i
            assign akey = 'asset_' | append: i
            assign title = section.settings[tkey]
            assign text = section.settings[xkey]
            assign img = section.settings[ikey]
            assign mid = section.settings[mkey]
            assign asset = section.settings[akey]
            assign num = i | prepend: '0'
          %}
          <article class="joynure-hula-card-3d joynure-hula-steps__card">
            <div class="joynure-hula-card-3d__media">
              {% render 'joynure-hula-media',
                product: product,
                setting_image: img,
                asset_file: asset,
                media_id: mid,
                alt: title,
                class: 'joynure-hula-landing__media',
                loading: 'lazy',
                sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 100vw'
              %}
            </div>
            <div class="joynure-hula-card-3d__body joynure-hula-steps__body">
              <p class="joynure-hula-how__num">{{ num }}</p>
              <h3>{{ title | escape }}</h3>
              <p>{{ text | escape }}</p>
            </div>
          </article>
        {% endfor %}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "JOYNURE Hula four steps",
  "tag": "section",
  "class": "joynure-hula-landing-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready in Four Simple Steps" },
    { "type": "textarea", "id": "lede", "label": "Supporting copy", "default": "A clear setup flow designed for first-time and returning users." },
    { "type": "image_picker", "id": "image_1", "label": "Step 1 image" },
    { "type": "text", "id": "asset_1", "label": "Step 1 theme asset", "default": "hula-step-1.jpg" },
    { "type": "text", "id": "media_id_1", "label": "Step 1 media ID", "default": "45010794578193" },
    { "type": "text", "id": "t1_title", "label": "Step 1 title", "default": "Adjust the Fit" },
    { "type": "textarea", "id": "t1_text", "label": "Step 1 text", "default": "Add or remove sections for a comfortable waist fit." },
    { "type": "image_picker", "id": "image_2", "label": "Step 2 image" },
    { "type": "text", "id": "asset_2", "label": "Step 2 theme asset", "default": "hula-step-2.jpg" },
    { "type": "text", "id": "media_id_2", "label": "Step 2 media ID", "default": "45010801230097" },
    { "type": "text", "id": "t2_title", "label": "Step 2 title", "default": "Secure the Hoop" },
    { "type": "textarea", "id": "t2_text", "label": "Step 2 text", "default": "Connect the sections securely around your waist." },
    { "type": "image_picker", "id": "image_3", "label": "Step 3 image" },
    { "type": "text", "id": "asset_3", "label": "Step 3 theme asset", "default": "hula-step-3.jpg" },
    { "type": "text", "id": "media_id_3", "label": "Step 3 media ID", "default": "45010994266385" },
    { "type": "text", "id": "t3_title", "label": "Step 3 title", "default": "Adjust the Cord" },
    { "type": "textarea", "id": "t3_text", "label": "Step 3 text", "default": "Set the weighted ball radius to a comfortable length." },
    { "type": "image_picker", "id": "image_4", "label": "Step 4 image" },
    { "type": "text", "id": "asset_4", "label": "Step 4 theme asset", "default": "hula-step-4.jpg" },
    { "type": "text", "id": "media_id_4", "label": "Step 4 media ID", "default": "45011023102225" },
    { "type": "text", "id": "t4_title", "label": "Step 4 title", "default": "Start Moving" },
    { "type": "textarea", "id": "t4_text", "label": "Step 4 text", "default": "Use steady waist movement to guide the weighted ball around the track." }
  ],
  "presets": [{ "name": "JOYNURE Hula four steps" }]
}
{% endschema %}
