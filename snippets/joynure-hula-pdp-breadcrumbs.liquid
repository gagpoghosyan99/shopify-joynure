{%- doc -%}
  Breadcrumb trail for modern PDPs. Hidden on Hula long-form PDP (customers see clean hero).
{%- enddoc -%}

{%- if product.handle == 'smart-weighted-hula-hoop-adjustable-24-section-fitness-hoop' -%}
  {%- comment -%} Intentionally hidden for Hula PDP {%- endcomment -%}
{%- else -%}
  {%- capture joynure_hula_pdp_flag -%}
    {%- render 'joynure-hula-pdp-enabled', product: product -%}
  {%- endcapture -%}
  {%- assign joynure_hula_pdp_flag = joynure_hula_pdp_flag | strip -%}

  {%- if joynure_hula_pdp_flag == 'true' -%}
    {%- capture joynure_shop_collection_handle -%}
      {%- render 'joynure-product-shop-collection', product: product -%}
    {%- endcapture -%}
    {%- assign joynure_shop_collection_handle = joynure_shop_collection_handle | strip -%}
    {%- assign joynure_crumb_label = 'Shop' -%}
    {%- assign joynure_crumb_url = routes.collections_url -%}

    {%- case joynure_shop_collection_handle -%}
      {%- when 'fitness-health' -%}
        {%- assign joynure_crumb_label = 'Hula Hoop' -%}
        {%- assign joynure_crumb_url = routes.collections_url | append: '/fitness-health' -%}
      {%- when 'pet-care' -%}
        {%- assign joynure_crumb_label = 'Pet Care' -%}
        {%- assign joynure_crumb_url = routes.collections_url | append: '/pet-care' -%}
      {%- when 'baby-care' -%}
        {%- assign joynure_crumb_label = 'Baby Care' -%}
        {%- assign joynure_crumb_url = routes.collections_url | append: '/baby-care' -%}
    {%- endcase -%}

    <nav class="joynure-pdp-breadcrumbs" aria-label="Breadcrumb">
      <ol class="joynure-pdp-breadcrumbs__list">
        <li class="joynure-pdp-breadcrumbs__item">
          <a href="{{ routes.root_url }}">Home</a>
        </li>
        <li class="joynure-pdp-breadcrumbs__item" aria-hidden="true">/</li>
        <li class="joynure-pdp-breadcrumbs__item">
          <a href="{{ joynure_crumb_url }}">{{ joynure_crumb_label | escape }}</a>
        </li>
        <li class="joynure-pdp-breadcrumbs__item" aria-hidden="true">/</li>
        <li class="joynure-pdp-breadcrumbs__item joynure-pdp-breadcrumbs__item--current" aria-current="page">
          {{ product.title | escape }}
        </li>
      </ol>
    </nav>
  {%- endif -%}
{%- endif -%}
