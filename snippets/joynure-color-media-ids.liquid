{%- doc -%}
  Returns a comma-separated list of product media IDs for a color on color-isolated PDPs.
  Used when Admin has not attached per-variant featured images (all colors share one gallery).

  @param {string} color - Color label (clean "Purple" or supplier "Color Box Purple 24Sections")
  @param {object} [product] - Optional product; when present, only Hula uses the Hula ID maps

  Outputs blank for unknown colors / non-Hula products when product is passed.
{%- enddoc -%}
{%- liquid
  assign color_raw = color | strip
  assign ids = ''
  assign product_handle = ''
  if product != blank
    assign product_handle = product.handle
  endif

  # Normalize supplier labels like "Color Box Purple 24Sections" → "Purple"
  capture color_clean
    render 'joynure-variant-label', label: color_raw
  endcapture
  assign color_key = color_clean | strip | downcase
  if color_key == blank
    assign color_key = color_raw | strip | downcase
  endif

  # When product is provided, only map Hula (other products use their own maps elsewhere / exact keys).
  # When product is blank, keep Hula maps for backward compatibility.
  assign apply_hula = false
  if product_handle == blank or product_handle == 'smart-weighted-hula-hoop-adjustable-24-section-fitness-hoop'
    assign apply_hula = true
  endif

  if apply_hula
    # Ordered hero-first (packshot / primary → lifestyle → details → assembly).
    # Mixed three-color group shot intentionally omitted from every color.
    if color_key == 'pink' or color_key contains 'pink'
      assign ids = '45010727797009,45010736709905,45010744803601,45010788942097,45010794578193,45010801230097,45010994266385,45011023102225'
    elsif color_key == 'purple' or color_key contains 'purple'
      assign ids = '45011048431889,45011048595729,45011048726801,45011021922577,45011048530193,45011048497425'
    elsif color_key == 'blue' or color_key contains 'blue'
      assign ids = '45011048562961,45011048661265,45011048694033,45011048628497,45011048464657'
    endif
  endif
-%}
{{- ids -}}
