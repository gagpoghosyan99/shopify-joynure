{%- doc -%}
  Returns a comma-separated list of product media IDs for a color on color-isolated PDPs.
  Used when Admin has not attached per-variant featured images (all colors share one gallery).

  @param {string} color - Color label (clean "Purple" or supplier "Color Box Purple 24Sections")
  @param {object} [product] - Optional product; scopes Hula vs Pet ID maps

  Outputs blank for unknown colors / unsupported products when product is passed.
{%- enddoc -%}
{%- liquid
  assign color_raw = color | strip
  assign ids = ''
  assign product_handle = ''
  if product != blank
    assign product_handle = product.handle
  endif

  # Normalize supplier labels like "Color Box Purple 24Sections" → "Purple"
  capture color_clean
    render 'joynure-variant-label', label: color_raw
  endcapture
  assign color_key = color_clean | strip | downcase
  if color_key == blank
    assign color_key = color_raw | strip | downcase
  endif

  if product_handle == blank or product_handle == 'smart-weighted-hula-hoop-adjustable-24-section-fitness-hoop'
    # Ordered hero-first (packshot / primary → lifestyle → details → assembly).
    # Mixed three-color group shot intentionally omitted from every color.
    if color_key == 'pink' or color_key contains 'pink'
      assign ids = '45010727797009,45010736709905,45010744803601,45010788942097,45010794578193,45010801230097,45010994266385,45011023102225'
    elsif color_key == 'purple' or color_key contains 'purple'
      assign ids = '45011048431889,45011048595729,45011048726801,45011021922577,45011048530193,45011048497425'
    elsif color_key == 'blue' or color_key contains 'blue'
      assign ids = '45011048562961,45011048661265,45011048694033,45011048628497,45011048464657'
    endif
  elsif product_handle == '2-in-1-reusable-pet-hair-remover'
    # Packshot / lifestyle first, then detail / mechanism shots. Mixed multi-color omitted.
    if color_key == 'blue' or color_key contains 'blue'
      assign ids = '45015235363089,45015235199249,45015236018449,45015235625233,45015235494161,45015236182289'
    elsif color_key == 'green' or color_key contains 'green'
      assign ids = '45015235166481,45015236083985,45015235526929,45015236313361'
    elsif color_key == 'pink' or color_key contains 'pink'
      assign ids = '45015235297553,45015235952913,45015235395857,45015235559697,45015235690769,45015235821841'
    elsif color_key == 'white' or color_key contains 'white'
      assign ids = '45015235264785,45015236116753,45015236051217,45015235658001,45015235723537'
    endif

  elsif product_handle == 'lectric-baby-nail-trimmer-set-gentle-safe-nail-care'
    # Electric baby nail trimmer — Blue (mint/teal) vs Pink only.
    if color_key == 'blue' or color_key contains 'blue'
      assign ids = '45018613186833,45018613514513,45018613678353,45018614071569,45018614399249,45018614202641,45018614169873,45018614497553,45018614890769,45018614825233,45018615283985,45018615087377,45018614858001'
    elsif color_key == 'pink' or color_key contains 'pink'
      assign ids = '45018613219601,45018613874961,45018612629777,45018613743889,45018614137105,45018613711121,45018614268177,45018614300945,45018614661393,45018614432017,45018614563089,45018614333713,45018614530321,45018614366481,45018614628625,45018614595857,45018614923537,45018614759697,45018614694161,45018614726929,45018614792465,45018614956305,45018615185681,45018615021841,45018615349521,45018615120145,45018615382289,45018615251217,45018615152913,45018615054609,45018615218449,45018615316753,45018614989073'
    endif
  elsif product_handle == 'portable-foldable-baby-changing-mat-waterproof-travel-changing-pad'
    if color_key == 'black grey' or color_key == 'black gray'
      assign ids = '45018740621585,45018741506321,45018741342481,45018741408017'
    elsif color_key == 'white black'
      assign ids = '45018740785425,45018740949265,45018740982033,45018741539089,45018741473553,45018741145873,45018741604625,44992155255057'
    elsif color_key == 'white grey' or color_key == 'white gray'
      assign ids = '45018740556049,45018740719889,45018741113105,45018741571857'
    elsif color_key == 'colorful'
      assign ids = '45018740752657,45018740818193,45018740883729,45018741244177,45018741178641'
    elsif color_key == 'gray' or color_key == 'grey'
      assign ids = '45018740523281,45018740588817,45018740850961,45018741440785,45018741211409'
    elsif color_key == 'black'
      assign ids = '45018740687121,45018741014801,45018741080337'
    endif
  endif
-%}
{{- ids -}}
