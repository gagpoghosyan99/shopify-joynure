{%- doc -%}
  Returns a comma-separated list of product media IDs for a color on a Joynure PDP.
  Used when Admin has not attached every image to a variant (shared gallery), or when
  hide_variants alone would still leave cross-color lifestyle shots visible.

  @param {string} color - Color option value (e.g. Pink, Blue, Black grey, Colorful)
  @param {object} [product] - Product object (handle selects the correct map)

  Outputs blank for unknown product/color pairs.
{%- enddoc -%}
{%- liquid
  assign color_key = color | strip | downcase
  assign ids = ''
  assign product_handle = ''
  if product != blank
    assign product_handle = product.handle
  endif

  if product_handle == '2-in-1-reusable-pet-hair-remover'
    # Pet hair remover — hero-first; every media ID belongs to exactly one color.
