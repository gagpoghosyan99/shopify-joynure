{%- doc -%}
  Display-only collection title for storefront heroes.
  Does not change Shopify Admin collection data.
{%- enddoc -%}

{%- case collection.handle -%}
  {%- when 'fitness-health' -%}
    HULA HOOP
  {%- when 'pet-care' -%}
    PET CARE
  {%- when 'baby-care' -%}
    BABY CARE
  {%- else -%}
    {{- collection.title -}}
{%- endcase -%}
