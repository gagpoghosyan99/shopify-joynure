{%- doc -%}
  Shared config for Hula Hoop PDP Phase B enhancements.
  Scoped to one product handle so other PDPs are unaffected.
{%- enddoc -%}

{%- liquid
  assign joynure_hula_pdp_handle = 'smart-weighted-hula-hoop-adjustable-24-section-fitness-hoop'
  assign joynure_hula_pdp_enabled = false

  if product != blank and product.handle == joynure_hula_pdp_handle
    assign joynure_hula_pdp_enabled = true
  endif
-%}
